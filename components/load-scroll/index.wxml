<view class="load-scroll-wrap" style="height: {{height}};">
  <view wx:if="{{refreshing}}" class="load-scroll-refresh">
    <van-loading size="18px" color="#4e62ff" />
    <text class="load-scroll-refresh-text">正在刷新...</text>
  </view>
  <scroll-view
    scroll-y
    show-scrollbar="{{false}}"
    class="load-scroll"
    style="height: {{height}};"
    lower-threshold="80"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    refresher-default-style="none"
    bindrefresherrefresh="handleRefresherRefresh"
    bindscroll="handleScroll"
    bindscrolltolower="handleScrollToLower"
  >
    <slot></slot>
    <view wx:if="{{error && !errorAppend && !loading && !refreshing}}" class="load-scroll-empty load-scroll-error">
      <van-empty
        image="error"
        description="{{resolvedErrorText}}"
        custom-class="load-scroll-empty-card"
      />
      <van-button
        wx:if="{{errorButtonText}}"
        round
        custom-class="load-scroll-empty-button"
        color="linear-gradient(135deg, #6881ff 0%, #4e62ff 100%)"
        bindtap="handleErrorRetry"
      >
        {{errorButtonText}}
      </van-button>
    </view>
    <view wx:if="{{empty && !loading && !refreshing && !error}}" class="load-scroll-empty">
      <van-empty
        image="search"
        description="{{resolvedEmptyText}}"
        custom-class="load-scroll-empty-card"
      />
      <van-button
        wx:if="{{emptyButtonText}}"
        round
        custom-class="load-scroll-empty-button"
        color="linear-gradient(135deg, #6881ff 0%, #4e62ff 100%)"
        bindtap="handleEmptyAction"
      >
        {{emptyButtonText}}
      </van-button>
    </view>
    <view wx:if="{{error && errorAppend && !loading && !refreshing}}" class="load-scroll-footer load-scroll-footer-error">
      <text class="load-scroll-footer-text">加载失败</text>
      <text class="load-scroll-retry-text" bindtap="handleErrorRetry">{{errorButtonText}}</text>
    </view>
    <view wx:if="{{loading && !refreshing && !empty && !error}}" class="load-scroll-footer">
      <van-loading size="16px" color="#4e62ff" />
      <text class="load-scroll-footer-text">正在加载...</text>
    </view>
    <view wx:if="{{finished && !loading && !empty && !error}}" class="load-scroll-footer">
      <text class="load-scroll-finished-text">{{finishedText}}</text>
    </view>
  </scroll-view>
</view>
