.load-scroll-wrap {
  position: relative;
  width: 100%;
  box-sizing: border-box;
}
.load-scroll {
  width: 100%;
  box-sizing: border-box;
}
.load-scroll-refresh,
.load-scroll-footer,
.load-scroll-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}
.load-scroll-refresh {
  position: absolute;
  top: 12px;
  left: 50%;
  z-index: 5;
  min-height: 0;
  padding: 0 16rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  pointer-events: none;
}
.load-scroll-footer {
  min-height: 88rpx;
  padding: 18rpx 0 calc(env(safe-area-inset-bottom) + 18rpx);
}
.load-scroll-empty {
  min-height: 220rpx;
  padding: 40rpx 0 calc(env(safe-area-inset-bottom) + 24rpx);
  flex-direction: column;
  gap: 24rpx;
}
.load-scroll-refresh-text,
.load-scroll-footer-text,
.load-scroll-finished-text,
.load-scroll-retry-text {
  display: block;
  font-size: 24rpx;
  color: #98a1b2;
  line-height: 1.4;
}
.load-scroll-finished-text {
  color: #a5adbc;
}
.load-scroll-retry-text {
  color: #4e62ff;
  font-weight: 700;
}
.load-scroll-footer-error {
  gap: 18rpx;
}
.load-scroll-empty-card {
  width: 100%;
}
.load-scroll-empty-button {
  min-width: 200rpx;
  height: 72rpx !important;
  padding: 0 30rpx;
  border: 0 !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  line-height: 72rpx !important;
  box-shadow: 0 10rpx 24rpx rgba(78, 98, 255, 0.16);
}
