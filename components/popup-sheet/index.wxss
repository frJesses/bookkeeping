:host {
  display: block;
}

.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.38);
  animation: popup-mask-fade-in 180ms ease-out both;
}

.popup-sheet {
  width: 100%;
  max-height: calc(100vh - env(safe-area-inset-top));
  padding: 30rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
  animation: popup-sheet-slide-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes popup-mask-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes popup-sheet-slide-in {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.popup-header {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  color: #333333;
}

.popup-title {
  min-width: 0;
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.popup-close {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  margin: -10rpx -12rpx -10rpx 16rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.popup-close-icon {
  color: #737b86;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 0.8;
}
