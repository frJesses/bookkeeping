:host {
  display: block;
  overflow: hidden;
}

.paged-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.load-state {
  display: flex;
  min-height: 420rpx;
  padding: 42rpx 30rpx 54rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
}

.load-state-image {
  display: block;
  width: 260rpx;
  height: 220rpx;
}

.state-title {
  margin-top: 18rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.state-description {
  margin-top: 10rpx;
  color: #989898;
  font-size: 23rpx;
}

.loading-state {
  min-height: 220rpx;
  color: #989898;
  font-size: 24rpx;
  gap: 18rpx;
}

.loading-ring {
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #d9f6ef;
  border-top-color: #01c6a6;
  border-radius: 50%;
  box-sizing: border-box;
  animation: loading-spin 700ms linear infinite;
}

.loading-ring-small {
  width: 30rpx;
  height: 30rpx;
  border-width: 4rpx;
}

.retry-button {
  display: flex;
  width: 220rpx !important;
  height: 72rpx;
  margin: 30rpx 0 0 !important;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 18rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1;
  box-sizing: border-box;
}

.retry-button::after {
  border: 0;
}

.load-more-row {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  color: #989898;
  font-size: 22rpx;
  gap: 14rpx;
}

.end-row {
  color: #c6c6c6;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}
