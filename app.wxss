/**app.wxss**/
page {
  --primary: #01c6a6;
  --primary-light: #14dbbb;
  --mint-surface: #e4f8f2;
  --page-bg: #f8f8f8;
  --text-main: #333333;
  --text-muted: #989898;
  background: var(--page-bg);
  color: var(--text-main);
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
  letter-spacing: 0;
}
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
}

button,
input,
textarea {
  font: inherit;
}

.ds-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--page-bg);
  color: var(--text-main);
}

.ds-header {
  position: relative;
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ds-header-title {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 600;
}

.ds-back-hitarea {
  position: absolute;
  left: 8rpx;
  top: 50%;
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  z-index: 1;
}

.ds-back-image {
  display: block;
  width: 24rpx;
  height: 40rpx;
}

.ds-back-image-light {
  filter: brightness(0) invert(1);
}

.ds-card {
  background: #ffffff;
  border-radius: 24rpx;
}

.ds-primary-button {
  display: flex;
  height: 96rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 24rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
}

.ds-primary-button::after {
  border: 0;
}

/* Shared native mini-program modal motion. */
.ui-popup-mask {
  animation: ui-popup-mask-fade-in 180ms ease-out both;
}

.ui-popup-sheet {
  animation: ui-popup-sheet-slide-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes ui-popup-mask-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes ui-popup-sheet-slide-in {
  from {
    opacity: 0;
    transform: translateY(100%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
