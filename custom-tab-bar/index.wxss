.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 28rpx calc(constant(safe-area-inset-bottom) + 18rpx);
  padding: 0 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  box-sizing: border-box;
  z-index: 99;
  pointer-events: none;
}
.tab-shell-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.tab-shell-hidden .tabbar {
  pointer-events: none;
}
.tabbar {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 120rpx;
  padding: 0 18rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  box-shadow: 0 18rpx 40rpx rgba(123, 133, 167, 0.1);
  backdrop-filter: blur(18rpx);
  pointer-events: auto;
  overflow: visible;
}
.tabbar-bump {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: -30rpx;
  width: 204rpx;
  margin-left: -102rpx;
  border-radius: 0 0 102rpx 102rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(47, 107, 255, 0.05);
  border-top: none;
  z-index: 0;
  box-shadow: 0 18rpx 40rpx rgba(123, 133, 167, 0.12);
}
.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 0;
  padding-bottom: 6rpx;
  box-sizing: border-box;
  z-index: 1;
}
.tab-item-special {
  position: relative;
  transform: translateY(-10rpx);
  padding-bottom: 0;
}
.tab-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-icon-active {
  color: #4e62ff;
}
.tab-icon-plus {
  width: 98rpx;
  height: 98rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #6d82ff 0%, #4e62ff 100%);
  box-shadow: 0 12rpx 24rpx rgba(78, 98, 255, 0.28);
}
.tab-icon-image {
  width: 44rpx;
  height: 44rpx;
}
.tab-icon-image-plus {
  width: 48rpx;
  height: 48rpx;
}
.tab-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.1;
  color: #9aa3b2;
}
.tab-text-active {
  color: #4e62ff;
  font-weight: 600;
}
