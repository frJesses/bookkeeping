.login-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(160deg, #c7f5e5 0%, #ffffff 24%, #ffffff 100%);
  box-sizing: border-box;
}

.login-close {
  position: absolute;
  left: 34rpx;
  top: 112rpx;
  width: 44rpx;
  height: 44rpx;
}

.login-close::before,
.login-close::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 4rpx;
  border-radius: 3rpx;
  background: #333333;
  transform: translate(-50%, -50%) rotate(45deg);
}

.login-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.login-main {
  display: flex;
  padding: 300rpx 80rpx 0;
  flex-direction: column;
  align-items: center;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
}

.carrier {
  margin-top: 80rpx;
  color: #989898;
  font-size: 24rpx;
}

.phone {
  margin-top: 24rpx;
  color: #080808;
  font-family: DIN, sans-serif;
  font-size: 52rpx;
  font-weight: 700;
}

.change-phone {
  margin-top: 26rpx;
  padding: 14rpx 26rpx;
  border-radius: 30rpx;
  background: #f8f8f8;
  color: #333333;
  font-size: 24rpx;
}

.login-button {
  display: flex;
  width: 100%;
  height: 106rpx;
  margin-top: 120rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 30rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
}

.login-button::after {
  border: 0;
}

.agreement {
  display: flex;
  margin-top: 30rpx;
  align-items: center;
  color: #555555;
  font-size: 22rpx;
}

.agreement-check {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #01c6a6;
  border-radius: 50%;
  color: #ffffff;
  font-size: 18rpx;
  box-sizing: border-box;
}

.agreement-checked {
  background: #01c6a6;
}

.agreement-link {
  color: #01c6a6;
}

.social-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 62rpx);
  display: flex;
  justify-content: center;
  gap: 88rpx;
}

.social-row image {
  width: 92rpx;
  height: 92rpx;
}
