<view class="budget-page">
  <view class="budget-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ds-header"><view class="ds-back-hitarea" bindtap="goBack"><image class="ds-back-image" src="/assets/common/back.png" mode="aspectFit"></image></view><text class="ds-header-title">我的预算</text></view>
    <view class="year-row"><picker mode="selector" range="{{yearOptions}}" value="{{yearIndex}}" bindchange="selectYear"><view class="year-picker-trigger"><text>{{year}}年</text><text class="year-caret"></text></view></picker><text>已添加{{addedMonthCount}}个月预算</text></view>
    <scroll-view scroll-x scroll-left="{{monthScrollLeft}}" scroll-with-animation class="month-scroll" show-scrollbar="false"><view class="month-row"><view wx:for="{{months}}" wx:key="label" class="month-card {{item.active ? 'month-active' : ''}}" data-index="{{index}}" bindtap="selectMonth"><text>{{item.label}}</text><text>{{item.added ? '已添加' : '未添加'}}</text></view></view></scroll-view>
    <view class="budget-hero"><text class="hero-label">收入总额(元)</text><text class="hero-value">{{incomeText}}</text><view class="adjust-income" bindtap="adjustIncome">收入调整</view><view class="hero-footer"><text>消费预算(元) <text>{{totalBudgetText}}</text></text><text>剩余预算(元) <text>{{remainingBudgetText}}</text></text></view></view>
  </view>
  <view class="budget-content">
    <scroll-view scroll-y class="budget-scroll" show-scrollbar="true">
      <view class="budget-scroll-content">
        <view wx:if="{{errorMessage}}" class="budget-state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重新加载</button></view>
        <view wx:elif="{{isLoading}}" class="budget-state">正在加载预算</view>
        <view wx:elif="{{!categories.length}}" class="budget-state">当前月份还没有预算，点击下方添加分类预算</view>
        <block wx:else><view wx:for="{{categories}}" wx:key="id" class="category-budget">
          <view class="category-heading"><view class="category-heading-title"><text>{{item.name}}预算</text><text wx:if="{{item.isDraft}}" class="draft-label">待设置</text></view><view class="category-heading-actions"><view class="category-delete" role="button" aria-label="删除该分类预算" data-index="{{index}}" catchtap="removeBudgetCategory"><image src="/assets/actions/delete.svg" mode="aspectFit"></image></view></view></view>
          <view class="budget-progress-panel" data-index="{{index}}" bindtap="openBudgetAmount"><view class="budget-progress-head"><text>预算使用进度</text><text>{{item.percent}}%</text></view><view class="budget-progress-track"><view class="budget-progress-value" style="width: {{item.percent}}%;"></view></view><view class="budget-progress-caption"><text>已支出 ¥{{item.spentText}} / 预算 ¥{{item.valueText}}</text><text>点击修改</text></view></view>
        </view></block>
      </view>
    </scroll-view>
    <view class="budget-action-bar">
      <button class="add-budget" bindtap="addBudget"><text>+</text> 添加预算</button>
    </view>
  </view>
  <popup-sheet wx:if="{{showIncomeModal}}" visible="{{showIncomeModal}}" title="调整收入" sheet-class="budget-modal" bind:close="closeIncomeModal">
      <input type="digit" value="{{incomeDraft}}" bindinput="handleIncomeInput" placeholder="请输入收入金额" />
      <view class="budget-modal-actions"><button bindtap="closeIncomeModal">取消</button><button class="budget-modal-confirm" bindtap="confirmIncome">确定</button></view>
  </popup-sheet>
  <popup-sheet wx:if="{{showCategoryModal}}" visible="{{showCategoryModal}}" title="选择预算分类" sheet-class="budget-modal category-picker-modal" bind:close="closeCategoryModal">
      <scroll-view scroll-y class="category-picker-scroll" show-scrollbar="true">
        <view wx:for="{{categoryPickerCandidates}}" wx:key="id" class="category-picker-row" data-index="{{index}}" bindtap="selectBudgetCategory">
          <image src="{{item.icon}}" mode="aspectFit"></image><text>{{item.name}}</text><text>添加</text>
        </view>
      </scroll-view>
      <button class="budget-modal-cancel" bindtap="closeCategoryModal">取消</button>
  </popup-sheet>
  <popup-sheet wx:if="{{showBudgetAmountModal}}" visible="{{showBudgetAmountModal}}" title="{{budgetAmountTitle}}" sheet-class="budget-modal budget-amount-modal" bind:close="closeBudgetAmount">
    <input class="budget-amount-input" type="digit" value="{{budgetAmountDraft}}" bindinput="handleBudgetAmountInput" placeholder="请输入预算金额" confirm-type="done" />
    <text class="budget-amount-hint">请输入 0.00 至 99999999.99 元</text>
    <view class="budget-modal-actions"><button bindtap="closeBudgetAmount">取消</button><button class="budget-modal-confirm" loading="{{savingBudgetAmount}}" disabled="{{savingBudgetAmount}}" bindtap="confirmBudgetAmount">保存</button></view>
  </popup-sheet>
</view>
