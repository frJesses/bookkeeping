<view class="page">
  <view class="page-content">
    <view class="hero-card">
      <text class="hero-title">预算提醒</text>
      <text class="hero-desc">先定下年度目标，再把预算拆到每个月，月底就不会突然慌张。</text>
    </view>

    <view wx:if="{{!hasBudget && !isEditing}}" class="empty-panel">
      <empty-state
        image="search"
        description="还没有预算设置，先建立一份你的年度预算吧"
        buttonText="开始设置预算"
        buttonColor="linear-gradient(135deg, #3b7cff 0%, #6d9eff 100%)"
        bind:action="startEdit"
      />
    </view>

    <view wx:else class="budget-panel">
      <view class="section-head">
        <text class="section-title">年度预算</text>
        <text class="section-tip">金额单位：元</text>
      </view>

      <van-cell-group custom-class="budget-group">
        <van-field
          label="年预算"
          type="digit"
          value="{{yearBudget}}"
          placeholder="请输入年预算"
          border="{{false}}"
          custom-class="budget-field"
          input-class="budget-field-input"
          data-field="yearBudget"
          bind:input="onFieldInput"
        />
      </van-cell-group>

      <view class="section-head section-head-gap">
        <text class="section-title">月度预算</text>
        <text class="section-tip">可分别设置每个月的预算</text>
      </view>

      <view class="month-grid">
        <block wx:for="{{monthlyBudgets}}" wx:key="key">
          <view class="month-card">
            <text class="month-label">{{item.label}}</text>
            <input
              class="month-input"
              type="digit"
              value="{{item.value}}"
              placeholder="0.00"
              adjust-position
              cursor-spacing="160"
              data-index="{{index}}"
              bindinput="onMonthInput"
            />
          </view>
        </block>
      </view>

      <view class="save-bar">
        <van-button round block color="linear-gradient(135deg, #2f6bff 0%, #5d8dff 100%)" custom-class="save-button" bindtap="saveBudget">
          保存预算
        </van-button>
      </view>
    </view>
  </view>
</view>
