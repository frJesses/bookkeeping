<view class="page">
  <view class="page-backdrop"></view>
  <view class="page-content">
    <view class="hero-card">
      <text class="hero-kicker">Spending List</text>
      <text class="hero-title">{{monthLabel}}</text>
      <text class="hero-desc">{{summaryText}}</text>
      <view class="hero-meta">
        <text class="hero-total">{{totalExpenseText}}</text>
        <text class="hero-count">{{recordCountText}}</text>
      </view>
    </view>
    <view class="record-list">
      <block wx:for="{{records}}" wx:key="id">
        <view class="record-item">
          <view class="record-icon">{{item.categoryIcon}}</view>
          <view class="record-body">
            <view class="record-top">
              <text class="record-title">{{item.title}}</text>
              <text class="record-amount">{{item.amountText}}</text>
            </view>
            <view class="record-bottom">
              <text class="record-meta">{{item.category}}</text>
              <text class="record-meta">{{item.dateText}}</text>
            </view>
            <text class="record-note">{{item.note}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
