.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  color: #25282d;
}

.record-list {
  background: #ffffff;
}

.record-item {
  display: flex;
  min-height: 108rpx;
  padding: 0 30rpx;
  align-items: center;
  box-sizing: border-box;
}

.record-content {
  display: flex;
  min-height: 108rpx;
  margin-left: 18rpx;
  flex: 1;
  min-width: 0;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eceeef;
}

.record-item-last .record-content {
  border-bottom: 0;
}

.record-icon {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  color: #62676d;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
}

.record-icon-image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-name,
.record-date,
.record-amount,
.ranking-state-title,
.ranking-state-desc {
  display: block;
}

.record-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  line-height: 1.3;
  color: #30343a;
  font-weight: 500;
}

.record-date {
  margin-top: 7rpx;
  font-size: 22rpx;
  color: #999da3;
}

.record-amount {
  max-width: 230rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: #484c51;
  font-weight: 400;
  text-align: right;
}

.ranking-state {
  min-height: 72vh;
  padding: 220rpx 56rpx 80rpx;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.ranking-state-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #2c3035;
  font-weight: 600;
}

.ranking-state-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8c9198;
}

.state-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #feecef;
  color: #d94f60;
  font-size: 40rpx;
  font-weight: 700;
}

.loading-mark {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto;
  border: 5rpx solid #e1e3e5;
  border-top-color: #e4ba2e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.ranking-retry {
  width: 220rpx;
  margin-top: 30rpx;
  border: 0;
  border-radius: 8rpx;
  background: #2c3035;
  color: #ffffff;
  font-size: 25rpx;
}

.ranking-retry::after {
  border: 0;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 360px) {
  .record-item {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .record-icon {
    width: 62rpx;
    height: 62rpx;
  }

  .record-icon-image {
    width: 100%;
    height: 100%;
  }

  .record-content {
    margin-left: 14rpx;
  }

  .record-name,
  .record-amount {
    font-size: 26rpx;
  }

  .record-amount {
    max-width: 200rpx;
    margin-left: 14rpx;
  }
}
