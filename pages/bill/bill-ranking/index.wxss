.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  color: #25282d;
}

.custom-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  padding: 0 24rpx 8rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 1rpx 0 #eceeef;
}

.header-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-back {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.header-back-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 7rpx;
  border-bottom: 5rpx solid #25282d;
  border-left: 5rpx solid #25282d;
  transform: rotate(45deg);
}

.header-title {
  position: absolute;
  left: 50%;
  color: #25282d;
  font-size: 29rpx;
  font-weight: 600;
  transform: translateX(-50%);
}

.header-space {
  flex-shrink: 0;
}

.record-list {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  background: #ffffff;
}

.record-item {
  display: flex;
  min-height: 112rpx;
  padding: 0 42rpx;
  align-items: center;
  box-sizing: border-box;
}

.record-content {
  display: flex;
  min-height: 112rpx;
  margin-left: 22rpx;
  flex: 1;
  min-width: 0;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eceeef;
}

.record-item-last .record-content {
  border-bottom: 0;
}

.record-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 15rpx;
  color: #62676d;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
}

.record-icon-image {
  display: block;
  width: 46rpx;
  height: 46rpx;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-name,
.record-date,
.record-amount,
.ranking-state-title,
.ranking-state-desc {
  display: block;
}

.record-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  line-height: 1.25;
  color: #30343a;
  font-weight: 600;
}

.record-meta {
  display: flex;
  min-width: 0;
  margin-top: 6rpx;
  align-items: center;
}

.record-date {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #999da3;
}

.record-meta-divider {
  margin: 0 7rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #b0b4b8;
}

.record-remark {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  color: #9ea9aa;
}

.record-amount {
  max-width: 210rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  color: #30383d;
  font-weight: 550;
  text-align: right;
}

.ranking-state {
  min-height: 72vh;
  padding: 220rpx 56rpx 80rpx;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.ranking-state-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #2c3035;
  font-weight: 600;
}

.ranking-state-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8c9198;
}

.state-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #feecef;
  color: #d94f60;
  font-size: 40rpx;
  font-weight: 700;
}

.loading-mark {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto;
  border: 5rpx solid #e1e3e5;
  border-top-color: #e4ba2e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.ranking-retry {
  width: 220rpx;
  margin-top: 30rpx;
  border: 0;
  border-radius: 8rpx;
  background: #2c3035;
  color: #ffffff;
  font-size: 25rpx;
}

.ranking-retry::after {
  border: 0;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 360px) {
  .record-item {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .record-icon {
    width: 52rpx;
    height: 52rpx;
  }

  .record-icon-image {
    width: 44rpx;
    height: 44rpx;
  }

  .record-content {
    margin-left: 18rpx;
  }

  .record-name,
  .record-amount {
    font-size: 26rpx;
  }

  .record-amount {
    max-width: 200rpx;
    margin-left: 14rpx;
  }
}
