<view class="page">
  <view class="custom-header {{headerSolid ? 'custom-header-solid' : ''}}" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-main" style="height: {{navBarHeight}}px;">
      <view class="header-back" bindtap="goBack">‹</view>
      <text class="header-title {{headerSolid ? 'visible' : ''}}">{{monthLabel}}</text>
      <view class="header-space" style="width: {{capsuleWidth + capsuleRight}}px;"></view>
    </view>
  </view>

  <view wx:if="{{detailLoading}}" class="state-view">
    <view class="loading-mark"></view>
    <text class="state-title">正在整理月度账单</text>
  </view>
  <view wx:elif="{{detailError}}" class="state-view">
    <text class="state-symbol">!</text>
    <text class="state-title">月度详情加载失败</text>
    <text class="state-desc">{{detailError}}</text>
    <button class="retry-button" bindtap="handleRetry">重新加载</button>
  </view>

  <scroll-view wx:else scroll-y class="page-scroll" bindscroll="handlePageScroll">
    <view class="page-content" style="padding-top: calc({{statusBarHeight + navBarHeight}}px + 4rpx);">
      <view class="bill-hero">
        <view class="hero-copy">
          <text class="hero-kicker">{{year}} 年度月账单</text>
          <text class="hero-title">{{monthLabel}}</text>
          <text class="hero-subtitle">{{dataUpdatedText}}</text>
        </view>
        <view class="hero-chart" style="background: {{flowRingBackground}};">
          <view class="hero-chart-hole">
            <text class="hero-chart-label">收支</text>
          </view>
        </view>
      </view>

      <view class="summary-card">
        <view class="balance-row">
          <view class="balance-block">
            <text class="summary-label">本月结余</text>
            <text class="summary-value">{{totalBalanceText}}</text>
          </view>
          <view class="balance-divider"></view>
          <view class="balance-block muted">
            <text class="summary-label">上月结余</text>
            <text class="summary-value">{{previousBalanceText}}</text>
          </view>
        </view>
        <view class="flow-row">
          <text class="flow-name">支出</text>
          <view class="flow-track"><view class="flow-fill expense" style="width: {{expenseBarWidth}};"></view></view>
          <text class="flow-amount">¥{{expenseAmountText}}</text>
        </view>
        <view class="flow-row">
          <text class="flow-name">收入</text>
          <view class="flow-track"><view class="flow-fill income" style="width: {{incomeBarWidth}};"></view></view>
          <text class="flow-amount">¥{{incomeAmountText}}</text>
        </view>
      </view>

      <view wx:if="{{isEmpty}}" class="empty-card">
        <text class="empty-title">这个月还没有记录</text>
        <text class="empty-desc">新增收支后，分类、排行和趋势会自动生成。</text>
      </view>

      <view wx:if="{{categories.length}}" class="report-card">
        <text class="section-title">支出类别</text>
        <view class="category-overview">
          <view class="category-ring" style="background: {{categoryRingBackground}};">
            <view class="category-ring-hole">
              <text class="ring-label">支出</text>
              <text class="ring-value">{{expenseAmountText}}</text>
            </view>
          </view>
          <view class="category-table">
            <view class="category-table-head">
              <text>类别</text><text>占比</text><text>金额</text>
            </view>
            <block wx:for="{{categories}}" wx:key="categoryId">
              <view class="category-table-row">
                <view class="category-name"><text class="category-dot" style="background: {{item.color}};"></text><text>{{item.name}}</text></view>
                <text>{{item.ratioText}}</text>
                <text>{{item.amountText}}</text>
              </view>
            </block>
          </view>
        </view>

        <view wx:if="{{rankings.length}}" class="ranking-section">
          <view class="section-head">
            <text class="section-subtitle">支出排行</text>
            <text class="section-link" bindtap="goToRanking">查看更多 ›</text>
          </view>
          <block wx:for="{{rankings}}" wx:key="id">
            <view class="ranking-row">
              <text class="ranking-index">{{item.rank}}</text>
              <view class="ranking-icon">
                <image
                  wx:if="{{item.categoryIcon}}"
                  class="ranking-icon-image"
                  src="{{item.categoryIcon}}"
                  mode="aspectFit"
                />
                <text wx:else>{{item.iconText}}</text>
              </view>
              <view class="ranking-copy">
                <text class="ranking-name">{{item.title}}</text>
                <text class="ranking-meta">{{item.categoryName}} · {{item.dateText}}</text>
              </view>
              <text class="ranking-amount">{{item.amountText}}</text>
            </view>
          </block>
        </view>
      </view>

      <view wx:if="{{chartData.categories.length && !isEmpty}}" class="report-card">
        <text class="section-title">支出趋势</text>
        <view class="metric-grid">
          <block wx:for="{{trendMetrics}}" wx:key="label">
            <view class="metric-item">
              <text class="metric-label">{{item.label}}</text>
              <text class="metric-value">{{item.value}}</text>
              <text class="metric-note">{{item.note}}</text>
            </view>
          </block>
        </view>
        <view class="chart-box">
          <qiun-data-charts type="line" canvas2d="{{true}}" inScrollView="{{true}}" chartData="{{chartData}}" opts="{{chartOpts}}" />
        </view>
      </view>

      <view wx:if="{{comparisons.length}}" class="report-card">
        <text class="section-title">月支出对比</text>
        <view class="compare-chart">
          <block wx:for="{{comparisons}}" wx:key="month">
            <view class="compare-item">
              <text class="compare-value">{{item.amountText}}</text>
              <view class="compare-bar {{item.active ? 'active' : ''}}" style="height: {{item.height}};"></view>
              <text class="compare-label {{item.active ? 'active' : ''}}">{{item.label}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
