.page { min-height: 100vh; background: #f3f5f7; color: #202631; }
.custom-header { position: fixed; inset: 0 0 auto; z-index: 20; padding: 0 24rpx 8rpx; box-sizing: border-box; background: transparent; transition: background-color 180ms ease, box-shadow 180ms ease; }
.custom-header-solid { background: rgba(255, 255, 255, .96); box-shadow: 0 1rpx 0 #e5e9ee; }
.header-main { display: flex; align-items: center; justify-content: space-between; }
.header-back { width: 64rpx; font-size: 54rpx; line-height: 1; }
.header-title { font-size: 29rpx; font-weight: 600; color: transparent; transition: color 180ms ease; }
.header-title.visible { color: #202631; }
.header-space { flex-shrink: 0; }
.page-scroll { height: 100vh; }
.page-content { padding: 0 20rpx calc(env(safe-area-inset-bottom) + 40rpx); box-sizing: border-box; }
.bill-hero { display: flex; min-height: 250rpx; padding: 24rpx 12rpx 28rpx; align-items: center; justify-content: space-between; box-sizing: border-box; }
.hero-copy { flex: 1; min-width: 0; }
.hero-kicker, .hero-title, .hero-subtitle, .summary-label, .summary-value, .flow-name, .flow-amount, .section-title, .section-subtitle, .ring-label, .ring-value, .ranking-name, .ranking-meta, .ranking-amount, .metric-label, .metric-value, .metric-note, .compare-value, .compare-label, .state-title, .state-desc, .empty-title, .empty-desc { display: block; }
.hero-kicker { font-size: 22rpx; color: #7d8794; }
.hero-title { margin-top: 18rpx; font-size: 52rpx; line-height: 1.1; font-weight: 650; }
.hero-subtitle { margin-top: 16rpx; font-size: 23rpx; color: #7d8794; }
.hero-chart { position: relative; width: 170rpx; height: 170rpx; margin-right: 22rpx; border-radius: 50%; transform: rotate(-48deg); box-shadow: 0 16rpx 30rpx rgba(57, 67, 82, .12); }
.hero-chart-hole { position: absolute; inset: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f3f5f7; transform: rotate(48deg); }
.hero-chart-label { font-size: 22rpx; color: #687382; }
.summary-card, .report-card, .empty-card { margin-bottom: 22rpx; padding: 30rpx 28rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(45, 55, 72, .045); }
.balance-row, .flow-row, .category-overview, .category-table-head, .category-table-row, .category-name, .section-head, .ranking-row, .metric-grid, .compare-chart { display: flex; }
.balance-row { align-items: stretch; }
.balance-block { flex: 1; min-width: 0; }
.balance-block.muted .summary-value { color: #9aa2ae; }
.balance-divider { width: 1rpx; margin: 0 28rpx; background: #edf0f3; }
.summary-label { font-size: 22rpx; color: #929aa6; }
.summary-value { margin-top: 12rpx; font-size: 42rpx; line-height: 1.2; font-weight: 600; white-space: nowrap; }
.flow-row { margin-top: 28rpx; align-items: center; }
.flow-name { width: 52rpx; font-size: 22rpx; color: #7d8794; }
.flow-track { flex: 1; height: 18rpx; margin: 0 16rpx; border-radius: 4rpx; background: #edf0f3; overflow: hidden; }
.flow-fill { height: 100%; border-radius: 4rpx; }
.flow-fill.expense { background: #f4c735; }
.flow-fill.income { background: #2db487; }
.flow-amount { width: 142rpx; font-size: 23rpx; text-align: right; color: #414a57; }
.section-title { font-size: 31rpx; font-weight: 650; }
.category-overview { margin-top: 30rpx; align-items: center; }
.category-ring { position: relative; width: 220rpx; height: 220rpx; flex-shrink: 0; border-radius: 50%; }
.category-ring-hole { position: absolute; inset: 52rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #fff; }
.ring-label { font-size: 20rpx; color: #929aa6; }
.ring-value { max-width: 110rpx; margin-top: 6rpx; font-size: 21rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
.category-table { flex: 1; min-width: 0; margin-left: 26rpx; }
.category-table-head, .category-table-row { align-items: center; justify-content: space-between; min-height: 40rpx; gap: 8rpx; }
.category-table-head { color: #a0a7b2; font-size: 20rpx; }
.category-table-row { font-size: 21rpx; color: #505967; }
.category-table-head text:first-child, .category-table-row .category-name { flex: 1; min-width: 0; }
.category-table-head text:nth-child(2), .category-table-row > text:nth-child(2) { width: 66rpx; text-align: right; }
.category-table-head text:last-child, .category-table-row > text:last-child { width: 106rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.category-name { align-items: center; min-width: 0; }
.category-name text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.category-dot { width: 16rpx; height: 16rpx; margin-right: 10rpx; flex-shrink: 0; border-radius: 3rpx; }
.ranking-section { margin-top: 34rpx; padding-top: 26rpx; border-top: 1rpx solid #edf0f3; }
.section-head { align-items: center; justify-content: space-between; }
.section-subtitle { font-size: 25rpx; color: #66717f; }
.section-link { font-size: 22rpx; color: #8c95a2; }
.ranking-row { min-height: 104rpx; align-items: center; }
.ranking-index { width: 44rpx; font-size: 23rpx; color: #8f98a4; }
.ranking-icon { display: flex; width: 64rpx; height: 64rpx; flex-shrink: 0; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #e8ebef; border-radius: 50%; background: #f4f5f7; color: #697382; font-size: 24rpx; overflow: hidden; }
.ranking-icon-image { display: block; width: 38rpx; height: 38rpx; }
.ranking-copy { flex: 1; min-width: 0; margin-left: 16rpx; }
.ranking-name { font-size: 25rpx; font-weight: 550; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ranking-meta { margin-top: 7rpx; font-size: 20rpx; color: #9aa2ae; }
.ranking-amount { margin-left: 12rpx; font-size: 24rpx; font-weight: 600; }
.metric-grid { margin-top: 28rpx; gap: 16rpx; }
.metric-item { flex: 1; min-width: 0; }
.metric-label { font-size: 20rpx; color: #8f98a4; white-space: nowrap; }
.metric-value { margin-top: 12rpx; font-size: 31rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
.metric-note { margin-top: 8rpx; font-size: 19rpx; color: #a0a7b2; }
.chart-box { height: 360rpx; margin-top: 16rpx; }
.compare-chart { height: 270rpx; margin-top: 26rpx; align-items: flex-end; justify-content: space-around; gap: 10rpx; }
.compare-item { display: flex; flex: 1; height: 100%; min-width: 0; flex-direction: column; align-items: center; justify-content: flex-end; }
.compare-value { font-size: 18rpx; color: #8f98a4; transform: scale(.88); }
.compare-bar { width: 38rpx; margin-top: 10rpx; border-radius: 5rpx 5rpx 0 0; background: #c5cbd4; }
.compare-bar.active { background: #f4c735; }
.compare-label { margin-top: 12rpx; font-size: 21rpx; color: #8f98a4; }
.compare-label.active { color: #202631; font-weight: 650; }
.empty-card { padding-top: 70rpx; padding-bottom: 70rpx; text-align: center; }
.empty-title { font-size: 29rpx; font-weight: 600; }
.empty-desc, .state-desc { margin-top: 14rpx; font-size: 23rpx; line-height: 1.6; color: #8992a2; }
.state-view { min-height: 100vh; padding: 260rpx 56rpx 80rpx; box-sizing: border-box; text-align: center; }
.state-symbol { display: flex; width: 72rpx; height: 72rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 50%; background: #feecef; color: #d94f60; font-size: 40rpx; font-weight: 700; }
.loading-mark { width: 54rpx; height: 54rpx; margin: 0 auto 28rpx; border: 5rpx solid #dce1ea; border-top-color: #f0ad1d; border-radius: 50%; animation: spin .8s linear infinite; }
.state-title { margin-top: 24rpx; font-size: 30rpx; font-weight: 600; }
.retry-button { width: 220rpx; margin-top: 32rpx; border: 0; border-radius: 8rpx; background: #202631; color: #fff; font-size: 25rpx; }
.retry-button::after { border: 0; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 360px) {
  .summary-value { font-size: 36rpx; }
  .balance-divider { margin: 0 20rpx; }
  .category-ring { width: 184rpx; height: 184rpx; }
  .category-ring-hole { inset: 44rpx; }
  .category-table { margin-left: 18rpx; }
  .category-table-head, .category-table-row { font-size: 19rpx; }
  .category-table-head text:last-child, .category-table-row > text:last-child { width: 92rpx; }
  .metric-value { font-size: 27rpx; }
}
