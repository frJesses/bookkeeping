.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 180rpx);
  box-sizing: border-box;
  background: #f7f8fc;
}
.detail-card,
.empty-panel {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(88, 101, 140, 0.08);
}
.detail-card {
  padding: 32rpx 28rpx;
}
.detail-main {
  display: flex;
  align-items: center;
}
.detail-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #f5f7ff;
}
.detail-icon-image {
  width: 48rpx;
  height: 48rpx;
}
.detail-icon-placeholder {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(120, 133, 164, 0.18);
}
.detail-copy {
  margin-left: 20rpx;
  min-width: 0;
}
.detail-title,
.detail-type,
.detail-label,
.detail-value,
.empty-title,
.empty-desc {
  display: block;
}
.detail-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1d2340;
}
.detail-type {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b94ad;
}
.detail-value-amount {
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 700;
}
.detail-value-amount.expense {
  color: #ff5b6d;
}
.detail-value-amount.income {
  color: #17b66f;
}
.detail-info {
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(228, 233, 242, 0.9);
}
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(238, 241, 247, 0.9);
}
.detail-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}
.detail-label {
  font-size: 24rpx;
  color: #8b94ad;
}
.detail-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1f2643;
}
.empty-panel {
  padding: 48rpx 32rpx;
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d2340;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8b94ad;
}
.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);
  box-sizing: border-box;
  background: rgba(247, 248, 252, 0.96);
  backdrop-filter: blur(20rpx);
}
.footer-button {
  flex: 1;
  height: 88rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}
.footer-button::after {
  border: 0;
}
.footer-button-secondary {
  color: #ffffff;
  border: 1rpx solid transparent;
  background: linear-gradient(135deg, #6881ff 0%, #4e62ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(78, 98, 255, 0.22);
  text-shadow: 0 1rpx 0 rgba(23, 36, 92, 0.12);
}
.footer-button-primary {
  color: #ff5b6d;
  border: 1rpx solid rgba(255, 91, 109, 0.38);
  background: transparent;
}
