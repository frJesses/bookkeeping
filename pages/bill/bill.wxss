.page {
  height: 100vh;
  background: #ffffff;
}
.page-backdrop {
  position: fixed;
  inset: 0;
  background: #ffffff;
  pointer-events: none;
}
.page-scroll {
  height: 100%;
}
.page-content {
  min-height: 100%;
  padding: 0 28rpx 15px;
  box-sizing: border-box;
}
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: 0 28rpx 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}
.header-main {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.header-left {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.year-picker {
  flex-shrink: 0;
}
.year-picker-trigger {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 10rpx 12rpx 0;
}
.year-picker-text,
.year-picker-arrow,
.summary-label,
.summary-value,
.mini-chip-label,
.mini-chip-value,
.annual-cover-kicker,
.annual-cover-title,
.annual-cover-action,
.empty-year,
.empty-title,
.empty-desc,
.empty-action {
  display: block;
}
.year-picker-text {
  font-size: 28rpx;
  color: #232838;
  font-weight: 600;
}
.year-picker-arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #585f75;
}
.header-switch {
  flex: 1;
  display: flex;
  justify-content: center;
}
.header-capsule-placeholder {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  flex-shrink: 0;
}
.summary-card {
  position: relative;
  overflow: hidden;
  margin-top: 8rpx;
  padding: 30rpx 30rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #6d82ff 0%, #4e62ff 62%, #7ea7ff 100%);
  box-shadow: 0 18rpx 36rpx rgba(78, 98, 255, 0.22);
}
.summary-card-symbol,
.summary-card-glow {
  position: absolute;
  pointer-events: none;
}
.summary-card-symbol {
  right: 28rpx;
  top: 22rpx;
  font-size: 180rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.22);
  font-weight: 700;
}
.summary-card-glow {
  border-radius: 50%;
  filter: blur(8rpx);
}
.summary-card-glow-left {
  left: -40rpx;
  bottom: -20rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.18);
}
.summary-card-glow-right {
  right: 110rpx;
  top: -18rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.18);
}
.summary-label {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.84);
  font-weight: 600;
}
.summary-value {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 72rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 700;
}
.summary-side {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  margin-top: 42rpx;
}
.mini-chip {
  min-width: 220rpx;
}
.mini-chip-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
}
.mini-chip-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}
.annual-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(66, 92, 255, 0.94) 0%, rgba(93, 122, 255, 0.92) 58%, rgba(61, 86, 233, 0.94) 100%);
  box-shadow: 0 20rpx 36rpx rgba(78, 98, 255, 0.18);
}
.annual-cover-decor,
.annual-cover-pattern {
  position: absolute;
  pointer-events: none;
}
.annual-cover-decor {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
}
.annual-cover-decor-left {
  left: -90rpx;
  top: -120rpx;
}
.annual-cover-decor-right {
  right: -70rpx;
  bottom: -120rpx;
}
.annual-cover-pattern {
  width: 240rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(210, 225, 255, 0.34) 46%, rgba(255, 255, 255, 0) 100%);
  transform: rotate(-18deg);
}
.annual-cover-pattern-top {
  left: -10rpx;
  top: 36rpx;
}
.annual-cover-pattern-bottom {
  left: 120rpx;
  bottom: 42rpx;
}
.annual-cover-kicker {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255, 246, 239, 0.82);
  letter-spacing: 2rpx;
}
.annual-cover-title {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 46rpx;
  line-height: 1.05;
  color: #fff8f2;
  font-weight: 700;
}
.annual-cover-action {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  min-width: 156rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #edf3ff 0%, #d6e2ff 100%);
  color: #425bce;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}
.empty-wrap {
  padding-top: 22rpx;
}
.empty-panel {
  padding: 40rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);
  box-shadow: 0 16rpx 34rpx rgba(85, 93, 123, 0.08);
}
.empty-year {
  font-size: 24rpx;
  color: #8f97a9;
}
.empty-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  line-height: 1.2;
  color: #1d2336;
  font-weight: 700;
}
.empty-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8d95a8;
}
.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  min-width: 180rpx;
  height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #1f232e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}
