.member-page { height: 100vh; overflow: hidden; padding-left: 30rpx; padding-right: 30rpx; background: #f8f8f8; box-sizing: border-box; }
.member-scroll { height: calc(100vh - 230rpx); }
.member-hero { position: relative; height: 300rpx; margin-top: 16rpx; padding: 134rpx 40rpx 30rpx; overflow: hidden; border-radius: 38rpx; background: linear-gradient(135deg, #232321 0%, #101110 100%); color: #d9b899; box-sizing: border-box; }
.member-glow { position: absolute; right: -80rpx; top: 30rpx; width: 360rpx; height: 360rpx; background: linear-gradient(135deg, rgba(255,255,255,.06), transparent); transform: rotate(30deg); }
.opened { display: block; width: fit-content; padding: 7rpx 18rpx; border-radius: 20rpx; background: rgba(0,0,0,.32); font-size: 22rpx; }
.hero-copy { position: absolute; left: 40rpx; bottom: 34rpx; font-size: 25rpx; }
.plan-row { display: grid; margin-top: 54rpx; grid-template-columns: repeat(3, 1fr); gap: 24rpx; }
.plan-card { position: relative; display: flex; height: 240rpx; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid #e0e0e0; border-radius: 24rpx; background: #ffffff; }
.plan-active { border: 4rpx solid #333333; }
.plan-tag { position: absolute; left: -4rpx; top: -20rpx; padding: 8rpx 14rpx; border-radius: 12rpx 12rpx 0 0; background: #333333; color: #ffffff; font-size: 18rpx; }
.plan-name { font-size: 27rpx; font-weight: 600; }
.plan-price { margin-top: 24rpx; font-family: DIN, sans-serif; font-size: 50rpx; font-weight: 700; }
.plan-price text { font-size: 28rpx; }
.plan-original { margin-top: 10rpx; color: #989898; font-size: 20rpx; text-decoration: line-through; }
.benefit-card { margin-top: 30rpx; padding: 30rpx 28rpx; border-radius: 24rpx; background: #ffffff; }
.benefit-title { display: block; font-size: 30rpx; font-weight: 600; }
.benefit-row { display: grid; margin-top: 28rpx; grid-template-columns: repeat(4, 1fr); }
.benefit-row view { display: flex; flex-direction: column; align-items: center; color: #666666; font-size: 21rpx; }
.benefit-icon { display: flex; width: 88rpx; height: 88rpx; margin-bottom: 18rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f5f1ed; color: #9e8065; font-size: 30rpx; }
.review-scroll { margin-top: 32rpx; width: 100%; white-space: nowrap; }
.review-row { display: flex; gap: 24rpx; }
.review-card { width: 500rpx; min-height: 180rpx; padding: 26rpx; border-radius: 24rpx; background: #ffffff; box-sizing: border-box; white-space: normal; }
.review-card view { display: flex; align-items: center; font-size: 25rpx; }
.review-card image { width: 52rpx; height: 52rpx; margin-right: 14rpx; border-radius: 50%; }
.review-card > text { display: block; margin-top: 18rpx; font-size: 24rpx; line-height: 1.8; }
.pay-button { position: fixed; left: 30rpx; right: 30rpx; bottom: calc(env(safe-area-inset-bottom) + 26rpx); display: flex; height: 106rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border: 0; border-radius: 24rpx; background: #292825; color: #ffffff; font-size: 30rpx; line-height: 1; box-sizing: border-box; }
.pay-button::after { border: 0; }
.pay-button text { color: #989898; font-size: 22rpx; text-decoration: line-through; }
