.categories-page {
  position: relative;
  display: flex;
  height: 100vh;
  overflow: hidden;
  padding-right: 30rpx;
  padding-left: 30rpx;
  flex-direction: column;
  background: #f8f8f8;
  box-sizing: border-box;
}

.page-background {
  position: fixed;
  inset: 0 0 auto;
  z-index: 0;
  width: 100%;
  height: 376rpx;
  pointer-events: none;
}

.categories-page .ds-header,
.categories-content {
  position: relative;
  z-index: 1;
}

.categories-page .ds-header {
  flex-shrink: 0;
}

.categories-content {
  display: flex;
  min-height: 0;
  flex: 1;
  height: auto;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.type-tabs {
  display: flex;
  width: 360rpx;
  height: 64rpx;
  margin: 16rpx auto 0;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #f0f2f2;
  box-sizing: border-box;
}

.type-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #989898;
  font-size: 25rpx;
  font-weight: 600;
}

.type-tab-active {
  background: #01c6a6;
  color: #ffffff;
}

.category-hint {
  margin: 22rpx 8rpx 14rpx;
  color: #989898;
  font-size: 22rpx;
}

.category-scroll {
  min-height: 0;
  flex: 1;
  width: calc(100% + 60rpx);
  margin-right: -60rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
}

.category-card {
  margin-right: 30rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.category-row,
.category-main {
  display: flex;
  align-items: center;
}

.category-row {
  min-height: 116rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.category-row:last-child {
  border-bottom: 0;
}

.category-main {
  min-width: 0;
  flex: 1;
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.category-name {
  overflow: hidden;
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.default-label {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #e9faf5;
  color: #01a98f;
  font-size: 21rpx;
}

.category-delete {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-left: 14rpx;
  border-radius: 50%;
  background: #fffafa;
  box-sizing: border-box;
}

.category-delete-image {
  width: 30rpx;
  height: 30rpx;
}

.category-delete-disabled {
  opacity: 0.4;
}

.category-state {
  padding: 80rpx 0;
  color: #989898;
  font-size: 24rpx;
  text-align: center;
}

.category-state-error {
  color: #e05b61;
}

.add-category-button {
  display: flex;
  width: 100%;
  height: 88rpx;
  margin: 20rpx 0 15px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 24rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.add-category-button::after,
.create-submit::after {
  border: 0;
}

.create-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.35);
  animation: create-mask-in 180ms ease-out both;
}

.create-sheet {
  width: 100%;
  max-height: 90vh;
  padding: 30rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
  animation: create-sheet-in 220ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
}

.create-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333333;
  font-size: 32rpx;
  font-weight: 700;
}

.create-close {
  color: #989898;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
}

.create-input {
  height: 84rpx;
  width: 100%;
  padding: 0 24rpx;
  padding-right: 96rpx;
  border-radius: 18rpx;
  background: #f7f8f8;
  color: #333333;
  font-size: 27rpx;
  line-height: 84rpx;
  box-sizing: border-box;
}

.create-input-wrap {
  position: relative;
  margin-top: 24rpx;
}

.create-input-count {
  position: absolute;
  right: 24rpx;
  top: 50%;
  color: #989898;
  font-size: 21rpx;
  line-height: 1;
  transform: translateY(-50%);
}

.create-label {
  display: block;
  margin-top: 24rpx;
  color: #666666;
  font-size: 24rpx;
}

.icon-options {
  display: grid;
  max-height: 524rpx;
  margin-top: 14rpx;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  overflow-y: auto;
}

.icon-option {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.icon-option-image {
  width: 84rpx;
  height: 84rpx;
}

.icon-option-active {
  border-color: #01c6a6;
  background: transparent;
}

.create-submit {
  display: flex;
  width: 100%;
  height: 84rpx;
  margin-top: 26rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 22rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

@keyframes create-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes create-sheet-in {
  from {
    opacity: 0;
    transform: translateY(100%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
