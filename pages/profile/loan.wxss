.loan-page {
  position: relative;
  display: flex;
  height: 100vh;
  overflow: hidden;
  padding-right: 30rpx;
  padding-left: 30rpx;
  flex-direction: column;
  background: #f8f8f8;
  box-sizing: border-box;
}

.page-background {
  position: fixed;
  inset: 0 0 auto;
  z-index: 0;
  width: 100%;
  height: 376rpx;
  pointer-events: none;
}
.loan-page .ds-header,
.loan-scroll,
.loan-add-bar {
  position: relative;
  z-index: 1;
}
.loan-page .ds-header {
  flex: 0 0 96rpx;
}
.loan-static {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
}
.loan-scroll {
  min-height: 0;
  height: auto;
  flex: 1;
  width: calc(100% + 60rpx);
  margin-left: -30rpx;
}
.loan-content {
  padding: 0 30rpx 24rpx;
}

.loan-summary {
  display: flex;
  margin: 18rpx 0;
  padding: 24rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
}
.loan-summary view {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
}
.loan-summary view + view {
  border-left: 1rpx solid #eeeeee;
}
.loan-summary text:first-child {
  color: #989898;
  font-size: 21rpx;
}
.loan-summary text:last-child {
  margin-top: 8rpx;
  color: #333333;
  font-family: DIN, sans-serif;
  font-size: 27rpx;
  font-weight: 700;
}
.loan-summary view:last-child text:last-child {
  color: #e05b61;
}

.loan-card {
  margin-bottom: 18rpx;
  padding: 26rpx 26rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
}
.loan-card-top,
.loan-person,
.loan-metrics,
.loan-actions {
  display: flex;
  align-items: center;
}
.loan-card-top {
  justify-content: space-between;
  align-items: center;
}
.loan-person {
  min-width: 0;
  gap: 16rpx;
}
.loan-avatar {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #e4f8f2;
  color: #01ad93;
  font-size: 26rpx;
  font-weight: 600;
}
.loan-borrower,
.loan-remark-inline {
  display: block;
}
.loan-borrower {
  color: #333333;
  font-size: 29rpx;
  font-weight: 600;
}
.loan-remark-inline {
  margin-top: 8rpx;
  color: #989898;
  font-size: 22rpx;
}
.loan-date-line {
  display: flex;
  margin-top: 14rpx;
  color: #989898;
  font-size: 21rpx;
  gap: 20rpx;
}
.loan-status {
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
}
.loan-status.open {
  background: #fff0f0;
  color: #e05b61;
}
.loan-status.partial {
  background: #fff7e6;
  color: #d48b22;
}
.loan-status.settled {
  background: #e4f8f2;
  color: #01ad93;
}
.loan-primary {
  display: flex;
  margin-top: 20rpx;
  align-items: baseline;
  justify-content: space-between;
}
.loan-primary text:first-child {
  color: #7f8794;
  font-size: 22rpx;
}
.loan-primary text:last-child {
  color: #e05b61;
  font-family: DIN, sans-serif;
  font-size: 36rpx;
  font-weight: 700;
}
.loan-metrics {
  display: grid;
  margin-top: 18rpx;
  padding: 12rpx 0;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-radius: 16rpx;
  background: #f8fafb;
}
.loan-metrics view {
  display: flex;
  min-width: 0;
  padding: 16rpx 10rpx;
  align-items: center;
  flex-direction: column;
}
.loan-metrics view + view {
  border-left: 1rpx solid #edf1f3;
}
.loan-metrics view text:first-child {
  color: #989898;
  font-size: 20rpx;
}
.loan-metrics view text:last-child {
  margin-top: 8rpx;
  color: #333333;
  font-family: DIN, sans-serif;
  font-size: 25rpx;
  font-weight: 600;
}
.loan-remaining {
  color: #e05b61 !important;
}
.loan-actions {
  margin-top: 18rpx;
  justify-content: stretch;
  gap: 14rpx;
}
.loan-actions button,
.loan-sheet-actions button {
  height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #dfe5ea;
  border-radius: 14rpx;
  background: #ffffff;
  color: #7f8794;
  font-size: 22rpx;
  line-height: 54rpx;
}
.loan-actions .loan-action {
  display: flex;
  flex: 1;
  height: 58rpx;
  padding: 0 10rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 1;
  gap: 8rpx;
}

.loan-action-repay {
  background: #01c6a6 !important;
}

.loan-action-edit {
  background: #5c8fff !important;
}

.loan-action-delete {
  background: #e05b61 !important;
}

.loan-action image {
  width: 28rpx;
  height: 28rpx;
}

.loan-action-symbol {
  font-size: 30rpx;
  line-height: 1;
}
.loan-actions button::after,
.loan-sheet-actions button::after {
  border: 0;
}

.loan-state,
.loan-empty {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #989898;
  font-size: 24rpx;
  text-align: center;
}
.loan-add-bar {
  flex: 0 0 auto;
  padding: 14rpx 0 calc(env(safe-area-inset-bottom) + 20rpx);
  background: #f8f8f8;
}
.loan-add,
.loan-save {
  display: flex;
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 29rpx;
  line-height: 1;
  box-sizing: border-box;
}
.loan-add::after,
.loan-save::after {
  border: 0;
}

.loan-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.35);
}
.loan-sheet,
.loan-repay-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 28rpx 30rpx calc(env(safe-area-inset-bottom) + 24rpx);
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}
.loan-sheet {
  max-height: 88vh;
}
.loan-repay-sheet {
  padding-bottom: calc(env(safe-area-inset-bottom) + 28rpx);
}
.loan-sheet-title {
  display: block;
  color: #333333;
  font-size: 31rpx;
  font-weight: 600;
  text-align: center;
}
.loan-input {
  height: 70rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f6f8fa;
  color: #333333;
  font-size: 24rpx;
  box-sizing: border-box;
}
.loan-date-row {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeeee;
  color: #333333;
  font-size: 25rpx;
}
.loan-date-value {
  display: flex;
  align-items: center;
  color: #7f8794;
}
.loan-caret {
  width: 0;
  height: 0;
  margin-left: 10rpx;
  border-top: 9rpx solid #a0a8b2;
  border-right: 7rpx solid transparent;
  border-left: 7rpx solid transparent;
}
.loan-due-toggle {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  color: #555d68;
  font-size: 24rpx;
}
.loan-checkbox {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ccd4dc;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 25rpx;
}
.loan-checkbox.checked {
  border-color: #01c6a6;
  background: #01c6a6;
}
.loan-form-error {
  display: block;
  margin-top: 14rpx;
  color: #e05b61;
  font-size: 22rpx;
}
.loan-sheet-actions {
  display: flex;
  margin-top: 20rpx;
  gap: 16rpx;
}
.loan-sheet-actions button {
  flex: 1;
  height: 78rpx;
  line-height: 76rpx;
}
.loan-sheet-actions .loan-save {
  background: #01c6a6;
  color: #ffffff;
}
