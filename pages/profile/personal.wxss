.personal-page {
  min-height: 100vh;
  padding-left: 30rpx;
  padding-right: 30rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

.page-back {
  position: absolute;
  left: 0;
  width: 24rpx;
  height: 40rpx;
}

.personal-card {
  margin-top: 16rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.personal-row {
  display: flex;
  height: 104rpx;
  padding: 0;
  align-items: center;
  border: 0;
  background: transparent;
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
  justify-content: flex-start;
  line-height: normal;
  text-align: left;
}

.personal-row::after {
  border: 0;
}

.avatar-row {
  width: 636rpx !important;
  height: 140rpx;
  margin: 0 !important;
}

.avatar-row image {
  width: 80rpx;
  height: 80rpx;
  margin-left: auto;
  border-radius: 50%;
}

.avatar-row-placeholder {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  margin-left: auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e4f8f2;
  color: #01c6a6;
  font-size: 30rpx;
  font-weight: 600;
}

.avatar-row .row-arrow-image {
  width: 12rpx;
  height: 24rpx;
  margin-left: 14rpx;
  border-radius: 0;
}

.row-value {
  max-width: 300rpx;
  overflow: hidden;
  margin-left: auto;
  color: #989898;
  font-weight: 400;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow-image {
  width: 12rpx;
  height: 24rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.row-divider {
  height: 1rpx;
  background: #eeeeee;
}

.gender-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.38);
}

.nickname-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.42);
  animation: nickname-mask-fade-in 180ms ease-out both;
}

.nickname-sheet {
  position: absolute;
  inset: auto 0 0;
  padding: 18rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  animation: nickname-sheet-slide-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nickname-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 8rpx;
  background: #d9dfe8;
}

.nickname-title {
  display: block;
  color: #20252d;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.nickname-input {
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  color: #20252d;
  font-size: 28rpx;
  box-sizing: border-box;
}

.nickname-actions {
  display: flex;
  margin: 32rpx -40rpx -32rpx;
  border-top: 1rpx solid #edf0f4;
}

.nickname-actions button {
  flex: 1;
  height: 100rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #ffffff;
  color: #20252d;
  font-size: 30rpx;
  line-height: 100rpx;
}

.nickname-actions button::after {
  border: 0;
}

.nickname-actions button + button {
  border-left: 1rpx solid #edf0f4;
}

.nickname-actions .nickname-save {
  color: #5870a9;
  font-weight: 600;
}

@keyframes nickname-mask-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes nickname-sheet-slide-in {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.gender-sheet {
  position: absolute;
  inset: auto 0 0;
  height: 500rpx;
  padding: 38rpx 110rpx calc(env(safe-area-inset-bottom) + 40rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.gender-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.gender-options {
  display: flex;
  margin-top: 72rpx;
  justify-content: space-between;
}

.gender-option {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gender-option image {
  width: 192rpx;
  height: 192rpx;
  border: 4rpx solid transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.gender-active image {
  border-color: #01c6a6;
}

.gender-option text {
  margin-top: 18rpx;
  font-size: 28rpx;
}
