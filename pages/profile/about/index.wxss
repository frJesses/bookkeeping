.page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  padding: 64rpx 32rpx 56rpx;
  background:
    radial-gradient(circle at top left, rgba(84, 126, 255, 0.14) 0, rgba(84, 126, 255, 0) 32%),
    linear-gradient(180deg, #eef4ff 0%, #f7f9ff 42%, #ffffff 100%);
  box-sizing: border-box;
}
.page-orb {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(10rpx);
  opacity: 0.65;
}
.page-orb-top {
  top: 120rpx;
  right: -56rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(112, 146, 255, 0.24);
}
.page-orb-bottom {
  left: -48rpx;
  bottom: 220rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(104, 196, 156, 0.18);
}
.hero {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 58rpx 34rpx 42rpx;
  border-radius: 44rpx;
  background:
    linear-gradient(155deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 46%),
    linear-gradient(135deg, #2f63ff 0%, #5d8dfd 52%, #7db2ff 100%);
  box-shadow: 0 30rpx 70rpx rgba(49, 96, 227, 0.24);
  box-sizing: border-box;
}
.hero-glow {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}
.hero-glow-left {
  top: 56rpx;
  left: 44rpx;
  width: 120rpx;
  height: 120rpx;
}
.hero-glow-right {
  right: 46rpx;
  bottom: 88rpx;
  width: 144rpx;
  height: 144rpx;
}
.hero-kicker {
  position: relative;
  display: inline-flex;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.about-logo {
  position: relative;
  margin-top: 28rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08);
}
.about-name,
.about-slogan,
.about-copy,
.info-title,
.section-kicker,
.section-title,
.highlight-title,
.highlight-desc,
.highlight-icon-text,
.version-pill-label,
.version-pill-value {
  display: block;
}
.about-name {
  margin-top: 32rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.about-slogan {
  margin-top: 18rpx;
  max-width: 470rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}
.version-pill {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(14, 33, 90, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08);
}
.version-pill-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}
.version-pill-value {
  margin-left: 14rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}
.section-card,
.info-panel {
  position: relative;
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(28, 48, 94, 0.08);
  backdrop-filter: blur(8rpx);
}
.section-head {
  margin-bottom: 24rpx;
}
.section-kicker {
  color: #7f90ad;
  font-size: 20rpx;
  letter-spacing: 1.8rpx;
  text-transform: uppercase;
}
.section-title {
  margin-top: 10rpx;
  color: #1e2b46;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}
.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.highlight-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #fbfcff 0%, #f4f7ff 100%);
}
.highlight-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.highlight-icon-blue {
  background: linear-gradient(180deg, #ebf2ff 0%, #dce8ff 100%);
  color: #2f63ff;
}
.highlight-icon-gold {
  background: linear-gradient(180deg, #fff4de 0%, #ffe7b9 100%);
  color: #cb8a1b;
}
.highlight-icon-green {
  background: linear-gradient(180deg, #e9fbf2 0%, #d5f2e2 100%);
  color: #1b9a60;
}
.highlight-icon-text {
  font-size: 30rpx;
  font-weight: 700;
}
.highlight-body {
  margin-left: 18rpx;
  flex: 1;
}
.highlight-title {
  color: #22314f;
  font-size: 28rpx;
  font-weight: 700;
}
.highlight-desc {
  margin-top: 8rpx;
  color: #66758f;
  font-size: 24rpx;
  line-height: 1.6;
}
.info-title {
  color: #20304d;
  font-size: 30rpx;
  font-weight: 700;
}
.about-copy {
  margin-top: 14rpx;
  color: #536179;
  font-size: 27rpx;
  line-height: 1.7;
}
