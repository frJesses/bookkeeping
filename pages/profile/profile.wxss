.page {
  min-height: 100vh;
  background: #f7f8fc;
}
.page-scroll {
  height: 100%;
  background: #f7f8fc;
}
.profile-header {
  padding: 146rpx 56rpx 58rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #6da1ff 100%);
  color: #ffffff;
  box-shadow: 0 22rpx 58rpx rgba(47, 107, 255, 0.18);
}
.profile-identity {
  display: flex;
  align-items: center;
}
.avatar {
  width: 116rpx;
  height: 116rpx;
  border: 6rpx solid #ffffff;
  border-radius: 58rpx;
  background: linear-gradient(135deg, #dfe7ff 0%, #7ba8ff 100%);
  box-sizing: border-box;
  color: #ffffff;
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 104rpx;
  overflow: hidden;
  text-align: center;
}
.avatar-image {
  display: block;
  width: 104rpx;
  height: 104rpx;
}
.nickname {
  display: block;
  margin-left: 34rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.2;
}
.summary-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 74rpx;
}
.summary-item {
  min-width: 0;
  text-align: center;
}
.summary-value,
.summary-label,
.menu-label {
  display: block;
}
.summary-value {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.15;
}
.summary-label {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  line-height: 1.25;
}
.menu-panel {
  padding: 28rpx 24rpx 0;
}
.profile-cell-group {
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(28, 48, 94, 0.08);
}
.profile-menu-row {
  position: relative;
}
.profile-cell {
  align-items: center;
  min-height: 112rpx;
}
.profile-cell-title {
  color: #24304a;
  font-size: 30rpx;
  font-weight: 500;
}
.share-trigger {
  position: absolute;
  inset: 0;
  z-index: 2;
  padding: 0;
  border: 0;
  background: transparent;
  opacity: 0;
  width: 100% !important;
}
.share-trigger::after {
  border: 0;
}
