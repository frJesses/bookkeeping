.export-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  padding-right: 30rpx;
  padding-left: 30rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

.page-background {
  position: fixed;
  inset: 0 0 auto;
  z-index: 0;
  width: 100%;
  height: 376rpx;
  pointer-events: none;
}

.export-page .ds-header,
.export-content {
  position: relative;
  z-index: 1;
}

.export-content {
  box-sizing: border-box;
}

.export-tip {
  margin: 18rpx 4rpx;
  color: #7f8794;
  font-size: 23rpx;
  line-height: 1.6;
}

.export-card {
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.export-card > picker {
  display: block;
}

.export-row {
  display: flex;
  width: 100%;
  min-height: 106rpx;
  align-items: center;
  justify-content: space-between;
}

.export-label {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.export-picker {
  display: flex;
  align-items: center;
  color: #727b89;
  font-size: 26rpx;
}

.export-caret {
  width: 0;
  height: 0;
  margin-left: 12rpx;
  border-top: 10rpx solid #9aa2ad;
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
}

.export-divider {
  height: 1rpx;
  background: #eeeeee;
}

.export-email-card {
  margin-top: 24rpx;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.export-email {
  height: 76rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #f6f8fa;
  color: #333333;
  font-size: 25rpx;
}

.export-error {
  margin: 18rpx 4rpx 0;
  color: #e05b61;
  font-size: 23rpx;
}

.export-submit {
  display: flex;
  height: 88rpx;
  margin: 36rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 29rpx;
  line-height: 1;
  box-sizing: border-box;
}

.export-submit::after {
  border: 0;
}

.export-records-link {
  margin-top: 30rpx;
  color: #01ad93;
  font-size: 25rpx;
  text-align: center;
}

.export-records-link text {
  margin-left: 6rpx;
  font-size: 32rpx;
}
