.settings-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  padding-right: 30rpx;
  padding-left: 30rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

.page-background {
  position: fixed;
  inset: 0 0 auto;
  z-index: 0;
  width: 100%;
  height: 376rpx;
  pointer-events: none;
}

.settings-page .ds-header,
.settings-content {
  position: relative;
  z-index: 1;
}

.settings-content {
  box-sizing: border-box;
}

.settings-card {
  margin-top: 16rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.settings-row {
  display: flex;
  min-height: 128rpx;
  align-items: center;
  border-bottom: 1rpx solid #eeeeee;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.settings-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.settings-title,
.settings-subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.settings-subtitle {
  margin-top: 10rpx;
  color: #989898;
  font-size: 22rpx;
  font-weight: 400;
}

.settings-arrow {
  width: 12rpx;
  height: 24rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}
