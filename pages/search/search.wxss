.search-page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  background: #f8f8f8;
}

.search-top {
  flex-shrink: 0;
  padding-bottom: 22rpx;
  border-radius: 0 0 32rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(1, 198, 166, 0.06);
}

.search-box-row {
  padding: 0 30rpx;
}

.search-box {
  display: flex;
  height: 84rpx;
  padding: 8rpx 8rpx 8rpx 26rpx;
  align-items: center;
  border-radius: 42rpx;
  background: #f2f7f5;
  box-sizing: border-box;
}

.search-box-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.search-input {
  height: 68rpx;
  flex: 1;
  color: #333333;
  font-size: 27rpx;
}

.search-placeholder {
  color: #b0b6c3;
}

.search-clear {
  margin-left: 8rpx;
  padding: 0 8rpx 4rpx;
  color: #98a1b2;
  font-size: 38rpx;
  line-height: 1;
}

.search-submit {
  display: flex;
  height: 68rpx;
  min-width: 128rpx;
  margin-left: 12rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
  flex-shrink: 0;
}

.filter-row {
  display: flex;
  margin-top: 20rpx;
  padding: 0 30rpx;
  align-items: center;
  gap: 16rpx;
}

.filter-row-second {
  margin-top: 14rpx;
  justify-content: space-between;
}

.filter-chip {
  display: flex;
  height: 58rpx;
  max-width: 390rpx;
  padding: 0 22rpx;
  align-items: center;
  overflow: hidden;
  border-radius: 29rpx;
  background: #f2f7f5;
  color: #4a5568;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-chip-category {
  max-width: 360rpx;
}

.filter-caret {
  width: 0;
  height: 0;
  margin-left: 10rpx;
  border-top: 10rpx solid #98a1b2;
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
  flex-shrink: 0;
}

.filter-hint {
  color: #b0b6c3;
  font-size: 21rpx;
}

.type-switch {
  display: flex;
  height: 58rpx;
  padding: 5rpx;
  border-radius: 29rpx;
  background: #f2f7f5;
  box-sizing: border-box;
}

.type-option {
  display: flex;
  min-width: 92rpx;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.type-option-active {
  background: #01c6a6;
  color: #ffffff;
  font-weight: 600;
}

.search-scroll {
  min-height: 0;
  flex: 1;
}

.search-content {
  padding: 24rpx 30rpx 0;
}

.summary-card {
  display: flex;
  margin-bottom: 24rpx;
  padding: 26rpx 10rpx;
  border-radius: 24rpx;
  background: #e4f8f2;
}

.summary-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-value {
  color: #1f2d3d;
  font-family: DIN, 'Helvetica Neue', sans-serif;
  font-size: 34rpx;
  font-weight: 700;
}

.summary-expense {
  color: #ff6b6b;
}

.summary-income {
  color: #01a98d;
}

.summary-label {
  color: #7c8798;
  font-size: 21rpx;
}

.truncated-tip {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff6e5;
  color: #b7791f;
  font-size: 22rpx;
  line-height: 1.5;
}

.search-state {
  display: flex;
  padding: 120rpx 30rpx;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #98a1b2;
  font-size: 26rpx;
}

.search-retry {
  display: flex;
  height: 68rpx;
  margin: 0;
  padding: 0 36rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 34rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1;
  box-sizing: border-box;
}

.search-retry::after {
  border: 0;
}

.loading-ring {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #e4f8f2;
  border-top-color: #01c6a6;
  border-radius: 50%;
  animation: search-spin 0.8s linear infinite;
}

@keyframes search-spin {
  to {
    transform: rotate(360deg);
  }
}

.record-group {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.record-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #989898;
  font-size: 24rpx;
}

.record-date,
.record-totals {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.record-totals {
  justify-content: flex-end;
  gap: 14rpx;
}

.record-divider {
  height: 1rpx;
  margin: 24rpx 0 4rpx;
  background: #eeeeee;
}

.search-bottom-space {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}
