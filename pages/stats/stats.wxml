<view class="page">
  <view
    class="custom-header"
    style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight + 6}}px;"
  >
    <view class="header-inner" style="height: {{navBarHeight}}px;">
      <text class="header-title">收支报表</text>
      <view
        class="header-capsule-placeholder"
        style="margin-top: {{capsuleTop - statusBarHeight}}px; height: {{capsuleHeight}}px; width: {{capsuleWidth}}px; margin-right: {{capsuleRight}}px;"
      />
    </view>
  </view>

  <view class="page-content" style="height: calc(100vh - {{tabBarSpacer + tabBarGap}}px); padding-top: {{statusBarHeight + navBarHeight + 4}}px;">
    <view class="filter-panel">
      <view class="report-switch">
        <block wx:for="{{reportOptions}}" wx:key="key">
          <view
            class="report-item {{activeReport === item.key ? 'report-item-active' : ''}}"
            data-report="{{item.key}}"
            bindtap="selectReport"
          >
            <text class="report-label">{{item.label}}</text>
            <view class="report-indicator"></view>
          </view>
        </block>
      </view>

      <view class="toolbar">
        <view class="date-picker" bindtap="openPeriodPicker">
          <view class="date-icon-shell">
            <image class="date-icon" src="/assets/stats/report-{{activeReport}}.svg" mode="aspectFit"></image>
          </view>
          <text class="date-value">{{dateRange}}</text>
          <text class="date-caret">⌄</text>
        </view>
        <view class="flow-switch">
          <view class="flow-pill {{activeFlow === 'expense' ? 'flow-pill-active flow-pill-expense' : ''}}" data-flow="expense" bindtap="selectFlow">支出</view>
          <view class="flow-pill {{activeFlow === 'income' ? 'flow-pill-active flow-pill-income' : ''}}" data-flow="income" bindtap="selectFlow">收入</view>
        </view>
      </view>
    </view>

    <scroll-view scroll-y class="content-scroll">
      <view wx:if="{{statsLoading}}" class="stats-state">
        <view class="loading-mark"></view>
        <text class="state-title">正在生成报表</text>
      </view>

      <view wx:elif="{{statsError}}" class="stats-state">
        <view class="state-symbol">!</view>
        <text class="state-title">报表加载失败</text>
        <text class="state-desc">{{statsError}}</text>
        <button class="retry-button" bindtap="handleRetry">重新加载</button>
      </view>

      <view wx:else class="report-body">
        <view class="summary-hero summary-hero-{{activeFlow}}">
          <view class="summary-hero-head">
            <view>
              <text class="summary-eyebrow">{{primaryMetric.label}}</text>
              <text class="summary-period">{{dateRange}}</text>
            </view>
            <view class="summary-flow-mark">
              <view class="summary-flow-dot"></view>
              <text>{{activeFlow === 'expense' ? '支出' : '收入'}}</text>
            </view>
          </view>
          <text class="summary-main-value">{{primaryMetric.value}}</text>
          <text class="summary-caption">{{activeReport === 'week' ? '本周累计' : activeReport === 'month' ? '本月累计' : '本年累计'}}</text>
          <view class="metric-strip">
            <block wx:for="{{secondaryMetrics}}" wx:key="label">
              <view class="metric-item">
                <text class="metric-label">{{item.label}}</text>
                <text class="metric-value">{{item.value}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="chart-section chart-section-primary">
          <view class="chart-heading">
            <view>
              <text class="chart-title">{{lineCardTitle}}</text>
              <text class="chart-subtitle">{{activeReport === 'year' ? '每月' : '每日'}}金额变化</text>
            </view>
            <view class="chart-legend {{activeFlow === 'income' ? 'chart-legend-income' : ''}}">
              <view class="chart-legend-dot"></view>
              <text class="chart-legend-text">{{activeFlow === 'expense' ? '支出' : '收入'}}</text>
            </view>
          </view>
          <view class="ucharts-box">
            <qiun-data-charts
              type="line"
              canvas2d="{{true}}"
              inScrollView="{{true}}"
              chartData="{{lineChartData}}"
              opts="{{lineChartOpts}}"
              ontap="{{true}}"
              tooltipShow="{{true}}"
            />
          </view>
        </view>

        <view class="chart-section chart-section-last">
          <view class="chart-heading">
            <view>
              <text class="chart-title">{{trendTitle}}</text>
              <text class="chart-subtitle">历史周期对比</text>
            </view>
          </view>
          <bar-trend
            axisLabels="{{barAxisLabels}}"
            points="{{barPoints}}"
            activeFlow="{{activeFlow}}"
            hasActivePoint="{{hasActiveBarPoint}}"
            tooltipLabel="{{barTooltipLabel}}"
            dateRange="{{dateRange}}"
            bind:select="selectBarPoint"
          />
        </view>
      </view>
    </scroll-view>
  </view>

  <van-popup
    show="{{showPeriodPicker}}"
    position="bottom"
    root-portal="{{true}}"
    round
    custom-class="period-popup"
    bind:close="closePeriodPicker"
    bind:after-leave="handlePeriodPickerAfterLeave"
  >
    <van-picker
      show-toolbar
      title="{{periodPickerTitle}}"
      columns="{{periodOptions}}"
      value-key="label"
      default-index="{{selectedPeriodIndex}}"
      cancel-button-text="取消"
      confirm-button-text="确定"
      visible-item-count="5"
      item-height="48"
      bind:cancel="closePeriodPicker"
      bind:confirm="confirmPeriodPicker"
    />
  </van-popup>
</view>
