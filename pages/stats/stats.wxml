<view class="page">
  <view class="page-content" style="height: calc(100vh - {{tabBarSpacer + tabBarGap}}px);">
    <view class="page-top">
      <view class="report-switch">
        <block wx:for="{{reportOptions}}" wx:key="key" wx:for-index="index">
          <view class="report-segment">
            <view class="report-item {{activeReport === item.key ? 'report-item-active' : ''}}" data-report="{{item.key}}" bindtap="selectReport">
              <image class="report-icon" src="{{item.icon}}" mode="aspectFit"></image>
              <text class="report-label">{{item.label}}</text>
            </view>
            <view wx:if="{{index !== reportOptions.length - 1}}" class="report-divider"></view>
          </view>
        </block>
      </view>
      <view class="page-inner">
        <view class="toolbar">
          <view class="date-picker" bindtap="openPeriodPicker">
            <text class="date-value">{{dateRange}}</text>
            <text class="date-caret">▼</text>
          </view>
          <view class="flow-switch">
            <view class="flow-pill {{activeFlow === 'expense' ? 'flow-pill-active' : ''}}" data-flow="expense" bindtap="selectFlow">支出</view>
            <view class="flow-pill {{activeFlow === 'income' ? 'flow-pill-active' : ''}}" data-flow="income" bindtap="selectFlow">收入</view>
          </view>
        </view>
      </view>
    </view>
    <scroll-view scroll-y class="content-scroll">
      <view class="page-inner">
        <view class="report-body">
          <view class="summary-card">
            <view class="metric-grid">
              <block wx:for="{{metrics}}" wx:key="label">
                <view class="metric-item">
                  <view class="metric-label-row">
                    <view class="metric-dot"></view>
                    <text class="metric-label">{{item.label}}</text>
                  </view>
                  <text class="metric-value {{item.accent === 'orange' ? 'metric-value-warm' : ''}}">{{item.value}}</text>
                </view>
              </block>
            </view>
          </view>
          <view class="chart-card">
            <text class="card-title">{{lineCardTitle}}</text>
            <view class="ucharts-box">
              <qiun-data-charts
                type="line"
                canvas2d="{{true}}"
                inScrollView="{{true}}"
                chartData="{{lineChartData}}"
                opts="{{lineChartOpts}}"
                ontap="{{true}}"
                tooltipShow="{{true}}"
              />
            </view>
          </view>
          <view class="chart-card chart-card-bottom">
            <text class="card-title">{{trendTitle}}</text>
            <bar-trend
              axisLabels="{{barAxisLabels}}"
              points="{{barPoints}}"
              activeFlow="{{activeFlow}}"
              hasActivePoint="{{hasActiveBarPoint}}"
              tooltipLabel="{{barTooltipLabel}}"
              dateRange="{{dateRange}}"
              bind:select="selectBarPoint"
            />
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <van-popup
    show="{{showPeriodPicker}}"
    position="bottom"
    root-portal="{{true}}"
    round
    custom-class="period-popup"
    bind:close="closePeriodPicker"
    bind:after-leave="handlePeriodPickerAfterLeave"
  >
    <van-picker
      show-toolbar
      title="{{periodPickerTitle}}"
      columns="{{periodOptions}}"
      value-key="label"
      default-index="{{selectedPeriodIndex}}"
      cancel-button-text="取消"
      confirm-button-text="确定"
      visible-item-count="5"
      item-height="48"
      bind:cancel="closePeriodPicker"
      bind:confirm="confirmPeriodPicker"
    />
  </van-popup>
</view>
