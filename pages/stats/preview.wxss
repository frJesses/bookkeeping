.preview-page {
  min-height: 100vh;
  padding-left: 30rpx;
  padding-right: 30rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

.preview-state {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #989898;
  font-size: 26rpx;
}

.preview-state button {
  display: flex;
  width: 220rpx;
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 18rpx;
  background: #01c6a6;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1;
}

.preview-state button::after {
  border: 0;
}

.preview-card,
.compare-panel {
  padding: 34rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.preview-title,
.compare-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.metric-grid {
  display: grid;
  margin-top: 34rpx;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.metric {
  display: flex;
  height: 194rpx;
  padding: 24rpx;
  flex-direction: column;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.metric-blue { background: #eff6ff; border-color: #e0edff; }
.metric-orange { background: #fff5f2; border-color: #ffe6df; }
.metric-green { background: #dcfbf7; border-color: #c8f3ee; }
.metric-pink { background: #fdf1f6; border-color: #fae6ee; }

.metric-mark {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.metric-mark image {
  display: block;
  width: 100%;
  height: 100%;
}

.metric > text:nth-child(2) {
  margin-top: 26rpx;
  color: #989898;
  font-size: 23rpx;
}

.metric > text:last-child {
  margin-top: 8rpx;
  font-family: DIN, sans-serif;
  font-size: 36rpx;
  font-weight: 700;
}

.compare-panel {
  margin-top: 24rpx;
}

.compare-row {
  display: flex;
  height: 76rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 16rpx;
  background: #f8f8f8;
  font-size: 24rpx;
}

.compare-active {
  width: 68%;
  background: #01c6a6;
  color: #ffffff;
  box-sizing: border-box;
}

.compare-short {
  width: 54%;
}
