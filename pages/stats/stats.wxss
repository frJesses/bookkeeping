.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f5f6fb;
  color: #20252b;
}

.custom-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  padding-left: 30rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.header-title {
  display: block;
  flex: 1;
  padding-right: 20rpx;
  color: #20252b;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 700;
}

.header-capsule-placeholder {
  flex-shrink: 0;
}

.page-content {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.filter-panel {
  flex-shrink: 0;
  padding: 4rpx 28rpx 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(77, 91, 143, 0.05);
}

.report-switch,
.toolbar,
.flow-switch,
.summary-hero-head,
.summary-flow-mark,
.metric-strip,
.chart-heading,
.chart-legend {
  display: flex;
}

.report-switch {
  height: 72rpx;
  border-bottom: 1rpx solid #edf0f4;
  box-sizing: border-box;
}

.report-item {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  color: #838b98;
}

.report-item-active {
  color: #4e62ff;
}

.report-label {
  font-size: 25rpx;
  font-weight: 600;
}

.report-indicator {
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 36rpx;
  height: 5rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: transparent;
  transform: translateX(-50%);
}

.report-item-active .report-indicator {
  background: #4e62ff;
}

.toolbar {
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.date-picker {
  display: flex;
  width: 350rpx;
  height: 62rpx;
  min-width: 0;
  flex-shrink: 0;
  padding: 0 18rpx 0 14rpx;
  align-items: center;
  border: 1rpx solid #d8ddff;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(78, 98, 255, 0.08);
  box-sizing: border-box;
}

.date-picker:active,
.report-item:active,
.flow-pill:active {
  opacity: 0.72;
}

.date-icon-shell {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.date-icon {
  width: 26rpx;
  height: 26rpx;
}

.date-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #36405b;
  font-size: 23rpx;
  font-weight: 600;
}

.date-caret {
  margin-left: 6rpx;
  color: #7180bd;
  font-size: 22rpx;
  line-height: 1;
}

.flow-switch {
  width: 226rpx;
  height: 62rpx;
  padding: 5rpx;
  flex-shrink: 0;
  align-items: center;
  border: 1rpx solid #e0e4ff;
  border-radius: 999rpx;
  background: #f0f2ff;
  box-sizing: border-box;
}

.flow-pill {
  display: flex;
  height: 50rpx;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #7b8492;
  font-size: 23rpx;
}

.flow-pill-active {
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(78, 98, 255, 0.2);
}

.flow-pill-expense {
  background: linear-gradient(180deg, #6d82ff 0%, #4e62ff 100%);
}

.flow-pill-income {
  background: linear-gradient(180deg, #43ae8b 0%, #278c6c 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(39, 140, 108, 0.18);
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

.report-body {
  padding: 20rpx 24rpx 52rpx;
}

.summary-hero {
  position: relative;
  padding: 26rpx 28rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #6d82ff 0%, #4e62ff 68%, #5874f2 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(78, 98, 255, 0.2);
}

.summary-hero::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 150rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.48);
}

.summary-hero-income {
  background: linear-gradient(145deg, #49b995 0%, #278c6c 72%, #227b60 100%);
  box-shadow: 0 14rpx 30rpx rgba(39, 140, 108, 0.18);
}

.summary-hero-head {
  position: relative;
  z-index: 1;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-eyebrow,
.summary-period,
.summary-main-value,
.summary-caption,
.metric-label,
.metric-value,
.chart-title,
.chart-subtitle,
.chart-legend-text,
.state-title,
.state-desc {
  display: block;
}

.summary-eyebrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.summary-period {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  font-weight: 600;
}

.summary-flow-mark {
  align-items: center;
  color: rgba(255, 255, 255, 0.76);
  font-size: 20rpx;
}

.summary-flow-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #ffffff;
}

.summary-hero-income .summary-flow-dot {
  background: #ffffff;
}

.summary-main-value {
  position: relative;
  z-index: 1;
  max-width: 100%;
  margin-top: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ffffff;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 700;
}

.summary-caption {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
}

.metric-strip {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.metric-item {
  flex: 1;
  min-width: 0;
  padding: 22rpx 12rpx 24rpx;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(255, 255, 255, 0.16);
}

.metric-item:last-child {
  border-right: 0;
}

.metric-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.64);
  font-size: 19rpx;
}

.metric-value {
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 650;
}

.chart-section {
  margin-top: 16rpx;
  padding: 26rpx 20rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid #e8eaf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(74, 86, 130, 0.05);
}

.chart-section-primary {
  padding-bottom: 12rpx;
}

.chart-section-last {
  margin-bottom: 12rpx;
  overflow: visible;
}

.chart-heading {
  padding: 0 6rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.chart-title {
  color: #20252b;
  font-size: 30rpx;
  font-weight: 650;
}

.chart-subtitle {
  margin-top: 7rpx;
  color: #9098a1;
  font-size: 20rpx;
}

.chart-legend {
  margin-top: 5rpx;
  align-items: center;
  color: #65707b;
  font-size: 19rpx;
}

.chart-legend-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #4e62ff;
}

.chart-legend-income .chart-legend-dot {
  background: #278c6c;
}

.ucharts-box {
  width: 100%;
  height: 344rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.stats-state {
  min-height: 70vh;
  padding: 210rpx 56rpx 80rpx;
  box-sizing: border-box;
  text-align: center;
}

.loading-mark {
  width: 50rpx;
  height: 50rpx;
  margin: 0 auto;
  border: 5rpx solid #dce1e6;
  border-top-color: #4e62ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state-symbol {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #feecef;
  color: #d94f60;
  font-size: 38rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 22rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.state-desc {
  margin-top: 12rpx;
  color: #858e9a;
  font-size: 22rpx;
  line-height: 1.6;
}

.retry-button {
  width: 220rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 8rpx;
  background: #20252b;
  color: #ffffff;
  font-size: 24rpx;
}

.retry-button::after {
  border: 0;
}

.period-popup {
  z-index: 200;
  overflow: hidden;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 360px) {
  .filter-panel {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .toolbar {
    gap: 14rpx;
  }

  .flow-switch {
    width: 210rpx;
  }

  .date-picker {
    width: 326rpx;
    padding: 0 14rpx 0 12rpx;
  }

  .date-value {
    font-size: 21rpx;
  }

  .report-body {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .summary-main-value {
    font-size: 52rpx;
  }

  .metric-item {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }

  .metric-label {
    font-size: 18rpx;
  }

  .metric-value {
    font-size: 22rpx;
  }
}
