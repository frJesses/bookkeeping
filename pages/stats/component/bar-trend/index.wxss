.bar-chart {
  margin-top: 16rpx;
  display: flex;
  align-items: stretch;
}
.y-axis {
  width: 70rpx;
  color: #9aa2ad;
  font-size: 18rpx;
}
.bar-axis {
  padding-top: 18rpx;
  padding-bottom: 42rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.axis-label {
  display: block;
}
.bar-chart-main {
  flex: 1;
  position: relative;
  height: 286rpx;
}
.bar-grid-lines {
  position: absolute;
  inset: 12rpx 0 46rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.grid-line {
  border-top: 1rpx dashed #dfe4e9;
}
.bar-columns {
  position: absolute;
  inset: 12rpx 0 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}
.bar-column {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 18rpx;
}
.bar-wrapper {
  position: relative;
  width: 48rpx;
  height: 198rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-fill {
  width: 42rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: #a9bff5;
  transition: height 420ms cubic-bezier(0.22, 1, 0.36, 1);
}
.bar-fill-active {
  background: #4e62ff;
}
.bar-chart-income .bar-fill {
  background: #a8d8c8;
}
.bar-chart-income .bar-fill-active {
  background: #278c6c;
}
.bar-tooltip {
  position: absolute;
  bottom: 84rpx;
  min-width: 190rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #202631;
  box-shadow: 0 10rpx 24rpx rgba(32, 38, 49, 0.18);
  z-index: 2;
  box-sizing: border-box;
}
.bar-tooltip-center {
  left: 50%;
  transform: translateX(-50%);
}
.bar-tooltip-left {
  right: -10rpx;
}
.bar-tooltip-right {
  left: -10rpx;
}
.bar-tooltip-label,
.bar-tooltip-value,
.bar-tooltip-date {
  display: block;
  color: #ffffff;
}
.bar-tooltip-label {
  font-size: 20rpx;
  font-weight: 600;
  opacity: 0.92;
}
.bar-tooltip-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.bar-tooltip-date {
  margin-top: 6rpx;
  font-size: 20rpx;
}
.bar-label {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #8f98a4;
}
