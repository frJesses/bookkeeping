.bar-chart {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
}

.y-axis {
  width: 78rpx;
  color: #b0b7c5;
  font-size: 18rpx;
}

.bar-axis {
  padding-top: 26rpx;
  padding-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.axis-label {
  display: block;
}

.bar-chart-main {
  flex: 1;
  position: relative;
  height: 308rpx;
}

.bar-grid-lines {
  position: absolute;
  inset: 18rpx 0 52rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  border-top: 2rpx dashed #edf1f8;
}

.bar-columns {
  position: absolute;
  inset: 18rpx 0 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.bar-column {
  width: 106rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 24rpx;
}

.bar-wrapper {
  position: relative;
  width: 58rpx;
  height: 208rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar-fill {
  width: 58rpx;
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  background: linear-gradient(180deg, rgba(92, 145, 255, 0.3) 0%, rgba(92, 145, 255, 0.76) 100%);
  transition: height 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.bar-fill-active {
  background: linear-gradient(180deg, #78a7ff 0%, #3a78ff 100%);
  box-shadow: 0 18rpx 32rpx rgba(58, 120, 255, 0.28);
}

.bar-tooltip {
  position: absolute;
  right: -28rpx;
  bottom: 128rpx;
  min-width: 190rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: #3a78ff;
  box-shadow: 0 16rpx 34rpx rgba(58, 120, 255, 0.3);
}

.bar-tooltip-label,
.bar-tooltip-value,
.bar-tooltip-date {
  display: block;
  color: #ffffff;
}

.bar-tooltip-label {
  font-size: 20rpx;
  font-weight: 600;
  opacity: 0.92;
}

.bar-tooltip-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.bar-tooltip-date {
  margin-top: 6rpx;
  font-size: 20rpx;
}

.bar-label {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #98a1b2;
}
