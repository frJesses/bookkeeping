<view class="page">
  <view class="page-backdrop"></view>
  <view
    class="custom-header"
    style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight + 8}}px;"
  >
    <view class="header-inner" style="height: {{navBarHeight}}px;">
      <view class="header-copy">
        <text class="header-kicker">钱小迹</text>
        <text class="header-title">{{statusText}}</text>
      </view>
      <view
        class="header-capsule-placeholder"
        style="margin-top: {{capsuleTop - statusBarHeight}}px; height: {{capsuleHeight}}px; width: {{capsuleWidth}}px; margin-right: {{capsuleRight}}px;"
      />
    </view>
  </view>
  <view
    class="page-content"
    style="padding-top: {{statusBarHeight + navBarHeight + 16}}px; padding-bottom: calc({{tabBarSpacer + tabBarGap}}px + 15px);"
  >
    <view class="overview-card">
      <image
        class="overview-card-background"
        src="/assets/common/banner.png"
        mode="aspectFill"
      />
      <view class="overview-head">
        <view class="overview-label-row">
          <text class="overview-label">{{summaryLabel}}</text>
          <view class="overview-visibility-button" bindtap="toggleOverviewAmounts">
            <image
              class="overview-visibility-icon"
              src="{{showOverviewAmounts ? '/assets/bill/eye-open.svg' : '/assets/bill/eye-close.svg'}}"
              mode="aspectFit"
            />
          </view>
        </view>
        <picker
          mode="selector"
          range="{{monthOptions}}"
          range-key="label"
          value="{{selectedMonthIndex}}"
          bindchange="handleMonthChange"
          class="overview-month-picker"
        >
          <view class="overview-month-trigger">
            <text class="overview-month-text">{{selectedMonthLabel}}</text>
            <text class="overview-month-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="overview-amount-row">
        <text class="overview-currency">¥</text>
        <text class="overview-value {{showOverviewAmounts ? '' : 'overview-value-masked'}}">{{showOverviewAmounts ? disposableAmountText : '******'}}</text>
      </view>
      <view class="overview-stats">
        <view class="overview-stat">
          <text class="overview-stat-label">本月收入</text>
          <text class="overview-stat-value {{showOverviewAmounts ? '' : 'overview-stat-value-masked'}}">{{showOverviewAmounts ? monthIncomeText : '******'}}</text>
        </view>
        <view class="overview-stat">
          <text class="overview-stat-label">本月支出</text>
          <text class="overview-stat-value {{showOverviewAmounts ? '' : 'overview-stat-value-masked'}}">{{showOverviewAmounts ? monthExpenseText : '******'}}</text>
        </view>
      </view>
    </view>
    <view class="section">
      <load-scroll
        id="homeLoadScroll"
        class="record-scroll"
        height="100%"
        delay="{{500}}"
        empty-text="这个月还没有记录，去记一笔让首页热闹起来。"
        empty-button-text="去记一笔"
        bindloaded="handleRecentRecordsLoaded"
        bindemptyaction="handleEmptyAction"
      >
        <view class="record-list">
          <block wx:for="{{recentRecordGroups}}" wx:key="groupKey" wx:for-index="groupIndex">
            <view class="record-group">
              <view class="record-group-head">
                <view class="record-group-date">
                  <text class="record-group-day">{{item.dateLabel}}</text>
                  <text class="record-group-week">{{item.weekLabel}}</text>
                </view>
                <view class="record-group-summary">
                  <text class="record-group-expense">支出 {{item.expenseText}}</text>
                  <text class="record-group-income">收入 {{item.incomeText}}</text>
                </view>
              </view>
              <block wx:for="{{item.records}}" wx:key="recordKey" wx:for-item="record" wx:for-index="recordIndex">
                <view class="record-item" bindtap="handleRecordTap" data-group-index="{{groupIndex}}" data-record-index="{{recordIndex}}">
                  <view
                    class="record-avatar"
                    style="background-color: {{record.iconBackgroundColor}}; border-color: {{record.iconBorderColor}};"
                  >
                    <view
                      wx:if="{{record.iconUrl && record.iconColor}}"
                      class="record-avatar-image record-avatar-image-tinted"
                      style="background-color: {{record.iconColor}}; -webkit-mask-image: url({{record.iconUrl}}); mask-image: url({{record.iconUrl}});"
                    ></view>
                    <image wx:elif="{{record.iconUrl}}" class="record-avatar-image" src="{{record.iconUrl}}" mode="aspectFit"></image>
                    <view wx:else class="record-avatar-placeholder"></view>
                  </view>
                  <view class="record-body">
                    <text class="record-name">{{record.title}}</text>
                    <text class="record-time">{{record.occurredTimeText}}</text>
                  </view>
                  <view class="record-side">
                    <view class="record-amount {{record.amountClass}}">
                      <text class="record-amount-sign">{{record.amountSign}}</text>
                      <text class="record-amount-value">{{record.amountValue}}</text>
                    </view>
                    <text class="record-tag">{{record.tagText}}</text>
                  </view>
                </view>
              </block>
            </view>
          </block>
        </view>
      </load-scroll>
    </view>
  </view>
</view>
