<view class="ledger-page">
  <image class="mint-wash" src="/assets/home/page-background.png" mode="scaleToFill"></image>
  <image
    class="brand-title"
    src="/assets/home/brand-title.png"
    mode="aspectFit"
    style="top: {{statusBarHeight + 10}}px;"
  ></image>
  <view
    class="header-actions"
    style="top: {{capsuleTop}}px; right: {{capsuleRight + capsuleWidth + 12}}px; height: {{capsuleHeight}}px;"
  >
    <view class="header-action" bindtap="goToCalendar">
      <image src="/assets/home/calendar.png" mode="aspectFit"></image>
    </view>
    <view class="header-action" bindtap="goToStats">
      <image src="/assets/home/statistics.png" mode="aspectFit"></image>
    </view>
  </view>
  <view
    class="summary-card"
    style="top: {{statusBarHeight + 54}}px;"
  >
    <image class="summary-card-background" src="/assets/home/summary-background.png" mode="scaleToFill"></image>
    <view class="month-picker month-trigger" bindtap="openDatePicker">
      <image class="month-background" src="/assets/home/month-background.png" mode="scaleToFill"></image>
      <text>{{selectedMonthLabel}}</text>
      <image class="caret" src="/assets/home/month-caret.png" mode="aspectFit"></image>
    </view>
    <text class="summary-label">当月支出(元)</text>
    <text class="summary-expense">{{monthExpenseText}}</text>
    <view class="summary-grid" bindtap="goToStats">
      <view>
        <text class="summary-label">当月收入(元)</text>
        <text class="summary-small-value">{{monthIncomeText}}</text>
      </view>
      <view>
        <text class="summary-label">本月余额(元)</text>
        <text class="summary-small-value">{{disposableAmountText}}</text>
      </view>
    </view>
  </view>

  <paged-scroll
    id="homePagedScroll"
    class="records-scroll"
    style="top: calc({{statusBarHeight + 54}}px + 290rpx);"
    bottom-space="{{tabBarSpacer + 16}}"
    bind:change="handleRecordsChange"
    bind:refresh="handleRecordsRefresh"
  >
    <view class="budget-card {{budgetIsOver ? 'budget-card-over' : ''}}" bindtap="goToBudget">
      <view class="budget-copy">
        <text wx:if="{{budgetConfigured}}">本月预算剩余：¥{{budgetRemainingText}}</text>
        <text wx:else>本月尚未设置预算</text>
        <text class="row-chevron">›</text>
      </view>
      <view wx:if="{{budgetConfigured}}" class="budget-track"><view class="budget-progress" style="width: {{budgetUsagePercent}}%;"></view></view>
      <view wx:if="{{budgetConfigured}}" class="budget-meta"><text>已用 ¥{{budgetSpentText}} / ¥{{budgetTotalText}}</text><text>{{budgetUsagePercent}}%</text></view>
    </view>

    <view class="record-list">
      <block wx:for="{{recentRecordGroups}}" wx:key="groupKey" wx:for-index="groupIndex">
        <view class="record-group">
          <view class="record-group-head" bindtap="goToCalendar">
            <view class="record-date">
              <text>{{item.dateLabel}}</text>
              <text>{{item.weekLabel}}</text>
            </view>
            <view class="record-totals">
              <text wx:if="{{item.expenseText}}">支出: {{item.expenseText}}</text>
              <text wx:if="{{item.hasIncome}}">收入: {{item.incomeText}}</text>
            </view>
          </view>
          <view class="record-divider"></view>
          <block wx:for="{{item.records}}" wx:key="recordKey" wx:for-item="record" wx:for-index="recordIndex">
            <transaction-swipe-row
              class="record-swipe-row"
              record="{{record}}"
              bind:open="handleSwipeOpen"
              bind:edit="handleRecordEdit"
              bind:delete="handleRecordDelete"
            />
          </block>
        </view>
      </block>
    </view>
  </paged-scroll>
  <view wx:if="{{showDatePicker}}" class="date-mask" bindtap="closeDatePicker">
    <view class="date-sheet" catchtap="noop">
      <text class="date-title">日期选择</text>
      <picker-view class="date-wheels" value="{{pickerValue}}" indicator-style="height: 92rpx;" bindchange="handleDatePickerChange" bindpickstart="handleDatePickerStart" bindpickend="handleDatePickerEnd">
        <picker-view-column>
          <view wx:for="{{pickerYears}}" wx:key="*this" class="wheel-item">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{pickerMonths}}" wx:key="*this" class="wheel-item">{{item}}月</view>
        </picker-view-column>
      </picker-view>
      <view class="date-actions"><button bindtap="closeDatePicker">取消</button><button class="date-confirm" bindtap="confirmDatePicker">确定</button></view>
    </view>
  </view>
  <view wx:if="{{showAchievementEffect}}" class="unlock-mask" bindtap="closeAchievementEffect">
    <view class="unlock-stage" catchtap="noop" bindtouchstart="handleUnlockTouchStart" bindtouchend="handleUnlockTouchEnd">
      <view class="unlock-close" bindtap="closeAchievementEffect"><text class="unlock-close-icon">×</text></view>
      <view class="unlock-icon-wrap">
        <view class="unlock-sparkle unlock-sparkle-a"></view>
        <view class="unlock-sparkle unlock-sparkle-b"></view>
        <view class="unlock-sparkle unlock-sparkle-c"></view>
        <view class="unlock-sparkle unlock-sparkle-d"></view>
        <image src="{{unlockEffects[unlockEffectIndex].image}}" mode="aspectFit"></image>
      </view>
      <text class="unlock-eyebrow">成就解锁</text>
      <text class="unlock-name">{{unlockEffects[unlockEffectIndex].name}}</text>
      <text class="unlock-description">{{unlockEffects[unlockEffectIndex].description}}</text>
      <view wx:if="{{unlockEffects.length > 1}}" class="unlock-dots">
        <view wx:for="{{unlockEffects}}" wx:key="code" class="unlock-dot {{index === unlockEffectIndex ? 'unlock-dot-active' : ''}}"></view>
      </view>
      <button class="unlock-button" bindtap="viewAchievements">查看成就</button>
    </view>
  </view>
</view>
