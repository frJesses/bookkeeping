.page {
  position: relative;
  height: 100vh;
  background: transparent;
}
.page-backdrop {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 10% 6%, rgba(126, 147, 255, 0.14) 0, rgba(126, 147, 255, 0) 26%),
    radial-gradient(circle at 88% 8%, rgba(200, 153, 255, 0.14) 0, rgba(200, 153, 255, 0) 24%),
    linear-gradient(180deg, #fcfdff 0%, #ffffff 34%, #fafbff 100%);
}
.page-content {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 0 28rpx 15px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-sizing: border-box;
  background: transparent;
}
.header-inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
}
.header-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.header-kicker,
.header-title {
  display: block;
}
.header-kicker {
  font-size: 34rpx;
  letter-spacing: 0;
  color: #3a4a76;
  font-weight: 700;
  line-height: 1.15;
}
.header-title {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8f97ad;
  font-weight: 600;
  line-height: 1.1;
}
.header-capsule-placeholder {
  flex-shrink: 0;
}
.overview-card,
.record-group,
.record-item {
  position: relative;
  z-index: 1;
}
.overview-card {
  overflow: hidden;
  padding: 24rpx 26rpx 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  box-shadow: 0 20rpx 40rpx rgba(101, 104, 255, 0.18);
}
.overview-card-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}
.overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.overview-label-row {
  display: inline-flex;
  align-items: center;
  min-width: 0;
}
.overview-month-picker {
  flex-shrink: 0;
  margin-left: 16rpx;
  z-index: 2;
}
.overview-month-trigger {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}
.overview-month-text,
.overview-month-arrow {
  display: block;
  color: #ffffff;
}
.overview-month-text {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}
.overview-month-arrow {
  margin-left: 10rpx;
  font-size: 18rpx;
  line-height: 1;
  opacity: 0.88;
}
.overview-label,
.overview-currency,
.overview-value,
.overview-stat-label,
.overview-stat-value,
.section-title,
.section-subtitle,
.section-link,
.record-name,
.record-time,
.record-amount,
.record-tag {
  display: block;
  color: #ffffff;
}
.overview-label {
  font-size: 22rpx;
  opacity: 0.9;
}
.overview-visibility-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 6rpx;
  border-radius: 999rpx;
}
.overview-visibility-icon {
  width: 34rpx;
  height: 34rpx;
}
.overview-amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 22rpx;
  position: relative;
  z-index: 1;
}
.overview-currency {
  margin-right: 8rpx;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  opacity: 0.9;
}
.overview-value {
  font-size: 70rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -1.6rpx;
}
.overview-value-masked {
  letter-spacing: 6rpx;
}
.overview-stats {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}
.overview-stat {
  flex: 1;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}
.overview-stat-label {
  font-size: 18rpx;
  opacity: 0.74;
}
.overview-stat-value {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
}
.overview-stat-value-masked {
  letter-spacing: 3rpx;
}
.section {
  margin-top: 28rpx;
  margin-left: -28rpx;
  margin-right: -28rpx;
  flex: 1;
  min-height: 0;
}
.record-scroll {
  height: 100%;
}
.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}
.record-group {
  padding: 20rpx 20rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 12rpx 28rpx rgba(80, 92, 135, 0.05);
}
.record-group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.record-group-date,
.record-group-summary {
  display: flex;
  flex-direction: column;
}
.record-group-day,
.record-group-week,
.record-group-expense,
.record-group-income {
  display: block;
}
.record-group-day {
  font-size: 28rpx;
  color: #1d2340;
  font-weight: 700;
}
.record-group-week {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #98a1b2;
}
.record-group-summary {
  align-items: flex-end;
  gap: 6rpx;
}
.record-group-expense,
.record-group-income {
  font-size: 20rpx;
  color: #7d869f;
}
.record-item {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-top: 1rpx solid rgba(228, 233, 242, 0.9);
  transition: transform 160ms ease, opacity 160ms ease;
}
.record-item:active {
  transform: scale(0.992);
  opacity: 0.92;
}
.record-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(228, 233, 242, 0.9);
}
.record-avatar-image {
  width: 40rpx;
  height: 40rpx;
}
.record-avatar-placeholder {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(120, 133, 164, 0.18);
}
.record-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.record-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2240;
}
.record-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a91aa;
}
.record-side {
  margin-left: 16rpx;
  text-align: right;
  flex-shrink: 0;
}
.record-amount {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  font-size: 30rpx;
  font-weight: 700;
}
.record-amount-sign,
.record-amount-value {
  display: block;
}
.record-amount-sign {
  margin-right: 6rpx;
  font-size: 22rpx;
  line-height: 1;
  opacity: 0.9;
}
.record-amount-value {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}
.record-amount.expense {
  color: #ff5b6d;
}
.record-amount.income {
  color: #17b66f;
}
.record-tag {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9ca3bb;
}
.empty-panel {
  padding: 40rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx dashed #d9dfeb;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2240;
}
.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b91aa;
}
@media (max-width: 375px) {
  .overview-value {
    font-size: 54rpx;
  }
  .overview-stats {
    gap: 14rpx;
  }
}
