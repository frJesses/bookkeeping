.page {
  position: relative;
  height: 100vh;
  background: transparent;
}
.page-backdrop {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-color: #f6f7fb;
  background-image:
    linear-gradient(rgba(226, 231, 242, 0.3) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(226, 231, 242, 0.28) 2rpx, transparent 2rpx);
  background-size: 36rpx 36rpx;
}
.page-content {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 0 28rpx 15px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  overflow: hidden;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-sizing: border-box;
  background: transparent;
  transition: background-color 180ms ease, box-shadow 180ms ease;
}
.custom-header-solid {
  background: rgba(247, 249, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(101, 117, 159, 0.08);
  backdrop-filter: blur(18rpx);
}
.header-inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10rpx;
}
.header-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.header-kicker,
.header-title {
  display: block;
}
.header-kicker {
  font-size: 28rpx;
  letter-spacing: 1rpx;
  color: #4a5576;
  font-weight: 700;
}
.header-title {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8e97b0;
  font-weight: 500;
}
.header-capsule-placeholder {
  flex-shrink: 0;
}
.overview-card,
.record-group,
.record-item {
  position: relative;
  z-index: 1;
}
.overview-card {
  overflow: hidden;
  padding: 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #4e62ff 0%, #6f8fff 58%, #7eb4ff 100%);
  box-shadow: 0 18rpx 36rpx rgba(83, 102, 255, 0.18);
}
.overview-month-picker {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  z-index: 2;
}
.overview-month-trigger {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}
.overview-month-text,
.overview-month-arrow {
  display: block;
  color: #ffffff;
}
.overview-month-text {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}
.overview-month-arrow {
  margin-left: 10rpx;
  font-size: 18rpx;
  line-height: 1;
  opacity: 0.88;
}
.overview-label,
.overview-currency,
.overview-value,
.overview-stat-label,
.overview-stat-value,
.section-title,
.section-subtitle,
.section-link,
.record-name,
.record-time,
.record-amount,
.record-tag {
  display: block;
  color: #ffffff;
}
.overview-label {
  font-size: 22rpx;
  opacity: 0.84;
  padding-right: 220rpx;
}
.overview-amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}
.overview-currency {
  margin-right: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  opacity: 0.9;
}
.overview-value {
  font-size: 62rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.overview-stats {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}
.overview-stat {
  flex: 1;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}
.overview-stat-label {
  font-size: 18rpx;
  opacity: 0.78;
}
.overview-stat-value {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
}
.section {
  margin-top: 28rpx;
  margin-left: -28rpx;
  margin-right: -28rpx;
  flex: 1;
  min-height: 0;
}
.record-scroll {
  height: 100%;
}
.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}
.record-group {
  padding: 20rpx 20rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 12rpx 28rpx rgba(80, 92, 135, 0.05);
}
.record-group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.record-group-date,
.record-group-summary {
  display: flex;
  flex-direction: column;
}
.record-group-day,
.record-group-week,
.record-group-expense,
.record-group-income {
  display: block;
}
.record-group-day {
  font-size: 28rpx;
  color: #1d2340;
  font-weight: 700;
}
.record-group-week {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #98a1b2;
}
.record-group-summary {
  align-items: flex-end;
  gap: 6rpx;
}
.record-group-expense,
.record-group-income {
  font-size: 20rpx;
  color: #7d869f;
}
.record-item {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-top: 1rpx solid rgba(228, 233, 242, 0.9);
  transition: transform 160ms ease, opacity 160ms ease;
}
.record-item:active {
  transform: scale(0.992);
  opacity: 0.92;
}
.record-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(228, 233, 242, 0.9);
}
.record-avatar-image {
  width: 40rpx;
  height: 40rpx;
}
.record-avatar-placeholder {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(120, 133, 164, 0.18);
}
.record-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.record-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2240;
}
.record-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a91aa;
}
.record-side {
  margin-left: 16rpx;
  text-align: right;
  flex-shrink: 0;
}
.record-amount {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  font-size: 30rpx;
  font-weight: 700;
}
.record-amount-sign,
.record-amount-value {
  display: block;
}
.record-amount-sign {
  margin-right: 6rpx;
  font-size: 22rpx;
  line-height: 1;
  opacity: 0.9;
}
.record-amount-value {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}
.record-amount.expense {
  color: #ff5b6d;
}
.record-amount.income {
  color: #17b66f;
}
.record-tag {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9ca3bb;
}
.empty-panel {
  padding: 40rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx dashed #d9dfeb;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2240;
}
.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b91aa;
}
@media (max-width: 375px) {
  .overview-value {
    font-size: 54rpx;
  }
  .overview-stats {
    gap: 14rpx;
  }
}
