.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 220rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.eyebrow {
  display: block;
  color: #667085;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #101828;
}

.balance-card {
  background: linear-gradient(135deg, #2f6bff 0%, #6fa2ff 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 24rpx 48rpx rgba(47, 107, 255, 0.18);
}

.balance-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.82;
}

.balance-value {
  display: block;
  margin-top: 18rpx;
  font-size: 60rpx;
  font-weight: 700;
}

.balance-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #101828;
}

.section-link {
  font-size: 24rpx;
  color: #2f6bff;
}

.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.shortcut-item,
.record-item {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(16, 24, 40, 0.06);
}

.shortcut-item {
  width: calc(50% - 10rpx);
  min-height: 176rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 38rpx;
  font-weight: 700;
}

.shortcut-text {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #182230;
  font-weight: 600;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  box-sizing: border-box;
}

.record-name,
.record-time,
.record-amount {
  display: block;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}

.record-time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667085;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.record-amount.expense {
  color: #f04438;
}

.record-amount.income {
  color: #12b76a;
}
