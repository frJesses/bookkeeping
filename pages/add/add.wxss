.page {
  height: 100vh;
  background: #ffffff;
}
.page-backdrop {
  position: fixed;
  inset: 0;
  background: #ffffff;
  pointer-events: none;
}
.page-scroll {
  height: 100%;
}
.page-content {
  min-height: 100%;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}
.page-content-with-composer {
  padding-bottom: 980rpx;
}
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}
.header-main {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.header-back {
  position: absolute;
  left: 0;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  text-align: center;
  line-height: 56rpx;
  flex-shrink: 0;
  transform: translateY(-50%);
}
.header-back-icon,
.selected-note-label,
.selected-note-value {
  display: block;
}
.header-back-icon {
  font-size: 56rpx;
  line-height: 56rpx;
  color: #171d2f;
  transform: translateX(-6rpx);
}
.header-capsule-placeholder {
  flex-shrink: 0;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}
.header-switch {
  display: flex;
  justify-content: center;
  width: 100%;
}
.category-state {
  padding: 100rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8992a7;
}
.category-state-error text {
  display: block;
}
.category-retry {
  width: 220rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 8rpx;
  background: #526dff;
  color: #ffffff;
  font-size: 25rpx;
}
.category-retry::after {
  border: 0;
}
