.add-page {
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
}

.add-page-form {
  background: #f8f8f8;
}

.add-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  background: #ffffff;
}

.header-switch {
  display: flex;
  justify-content: center;
}

.add-tag {
  position: absolute;
  right: 32rpx;
  top: 50%;
  width: 42rpx;
  height: 42rpx;
  transform: translateY(-50%);
}

.add-tag::before,
.add-tag::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 38rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #333333;
  transform: translate(-50%, -50%);
}

.add-tag::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.category-scroll {
  display: block;
  width: 100%;
  height: 100vh;
  padding: 24rpx 0 env(safe-area-inset-bottom) 24rpx;
  box-sizing: border-box;
}

.category-state {
  padding: 120rpx 30rpx;
  color: #989898;
  font-size: 26rpx;
  text-align: center;
}

.category-retry {
  display: flex;
  width: 220rpx;
  height: 72rpx;
  margin: 24rpx auto 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 16rpx;
  background: #01c6a6;
  color: #ffffff;
  line-height: 1;
  box-sizing: border-box;
}

.category-retry::after {
  border: 0;
}

.entry-form {
  height: 100vh;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
}

.category-summary,
.amount-panel,
.remark-panel {
  border-radius: 24rpx;
  background: #ffffff;
}

.category-summary {
  display: flex;
  height: 128rpx;
  padding: 0 26rpx;
  align-items: center;
}

.category-summary image {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.category-summary > text:nth-child(2) {
  font-size: 28rpx;
  font-weight: 600;
}

.change-category {
  margin-left: auto;
  color: #989898;
  font-size: 24rpx;
}

.amount-panel {
  height: 182rpx;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
}

.field-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.amount-line {
  display: flex;
  margin-top: 36rpx;
  align-items: center;
}

.currency {
  margin-right: 18rpx;
  font-family: DIN, sans-serif;
  font-size: 36rpx;
  font-weight: 700;
}

.amount-value {
  color: #333333;
  font-family: DIN, sans-serif;
  font-size: 34rpx;
  font-weight: 600;
}

.amount-placeholder {
  color: #cccccc;
  font-family: "PingFang SC", sans-serif;
  font-size: 25rpx;
  font-weight: 400;
}

.remark-panel {
  display: flex;
  height: 96rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  align-items: center;
}

.remark-input {
  flex: 1;
  margin-left: 32rpx;
  font-size: 25rpx;
}

.remark-count {
  color: #989898;
  font-size: 24rpx;
}

.native-keypad {
  position: fixed;
  inset: auto 0 0;
  display: flex;
  padding: 28rpx 30rpx calc(env(safe-area-inset-bottom) + 18rpx);
  gap: 8rpx;
  background: #f1f1f1;
}

.keypad-left {
  display: grid;
  flex: 1;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.keypad-right {
  display: flex;
  width: 168rpx;
  flex-direction: column;
  gap: 8rpx;
}

.key,
.confirm-key {
  display: flex;
  height: 102rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #ffffff;
  font-family: DIN, sans-serif;
  font-size: 40rpx;
  font-weight: 500;
}

.key-zero {
  grid-column: span 2;
}

.key-backspace {
  font-size: 34rpx;
}

.confirm-key {
  height: 322rpx;
  background: #01c6a6;
  color: #ffffff;
  font-family: "PingFang SC", sans-serif;
  font-size: 30rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.32);
}

.tag-sheet {
  position: absolute;
  inset: auto 0 0;
  max-height: 82vh;
  padding: 22rpx 30rpx calc(env(safe-area-inset-bottom) + 30rpx);
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow-x: hidden;
  overflow-y: auto;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.tag-name-input {
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f8f8f8;
  font-size: 24rpx;
  box-sizing: border-box;
}

.icon-heading {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.custom-icon-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 30rpx;
  row-gap: 20rpx;
  box-sizing: border-box;
}

.custom-icon-swiper {
  margin-top: 16rpx;
}

.custom-icon {
  position: relative;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  box-sizing: border-box;
}

.custom-icon image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.icon-check {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.sheet-dots {
  display: flex;
  margin-top: 16rpx;
  justify-content: center;
  gap: 8rpx;
}

.sheet-dots text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #dddddd;
}

.sheet-dots .dot-active {
  background: #01c6a6;
}

.tag-confirm {
  height: 76rpx;
  margin-top: 26rpx;
}
