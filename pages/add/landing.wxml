<view class="landing-page">
  <view class="landing-main">
    <view class="ds-header"><view class="ds-back-hitarea" bindtap="goBack"><image class="ds-back-image" src="/assets/common/back.png" mode="aspectFit"></image></view><text class="ds-header-title">添加记账</text></view>
    <view class="landing-month">
      <view><text bindtap="openDatePicker">{{monthLabel}} ▾</text><text>太棒了，你已经连续记账{{recordedDays}}天啦~</text></view>
      <view class="month-nav {{!canGoPreviousMonth ? 'month-nav-disabled' : ''}}" bindtap="handlePreviousMonth">‹</view>
      <view class="month-nav {{!canGoNextMonth ? 'month-nav-disabled' : ''}}" bindtap="handleNextMonth">›</view>
    </view>
    <view class="landing-week"><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view>
    <view class="landing-grid">
      <view wx:for="{{days}}" wx:key="key" class="landing-day {{item.isMuted ? 'landing-muted' : ''}} {{item.isDisabled ? 'landing-disabled' : ''}} {{item.isActive ? 'landing-active' : ''}}" data-date="{{item.date}}" data-disabled="{{item.isDisabled}}" bindtap="selectDay">
        <view wx:if="{{item.hasRecord && !item.isActive}}" class="day-dot"></view><text class="{{item.isToday ? 'landing-today-label' : ''}}">{{item.isToday ? '今日' : item.label}}</text>
      </view>
    </view>
  </view>
  <view class="landing-ledger">
    <view class="landing-ledger-head"><text>{{selectedDateLabel}}</text><text>支出: {{selectedExpenseText}}</text></view>
    <view class="landing-divider"></view>
    <scroll-view scroll-y bounces="false" class="landing-records" show-scrollbar="false">
      <empty-state
        wx:if="{{errorMessage}}"
        mode="error"
        title="账单加载失败"
        compact="{{true}}"
        show-retry="{{true}}"
        bind:retry="handleRetry"
      />
      <view wx:elif="{{isLoading}}" class="landing-state">正在加载</view>
      <view wx:elif="{{!selectedRecords.length}}" class="landing-state">当天暂无账单</view>
      <view wx:else><view wx:for="{{selectedRecords}}" wx:key="recordKey" class="landing-record"><image src="{{item.iconUrl}}" mode="aspectFit"></image><view><text>{{item.title}}</text><text>{{item.tagText}}</text></view><text>{{item.amountSign}}{{item.amountValue}}</text></view></view>
    </scroll-view>
    <button bindtap="startEntry"><image src="/assets/calendar/add-record.png" mode="aspectFit"></image><text>记一笔</text></button>
  </view>
</view>
<view wx:if="{{showDatePicker}}" class="date-mask" bindtap="closeDatePicker">
  <view class="date-sheet" catchtap="noop">
    <text class="date-title">月份选择</text>
    <picker-view class="date-wheels" value="{{pickerValue}}" indicator-style="height: 92rpx;" bindchange="handleDatePickerChange" bindpickstart="handleDatePickerStart" bindpickend="handleDatePickerEnd">
      <picker-view-column>
        <view wx:for="{{pickerYears}}" wx:key="*this" class="wheel-item">{{item}}年</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerMonths}}" wx:key="*this" class="wheel-item">{{item}}月</view>
      </picker-view-column>
    </picker-view>
    <view class="date-actions"><button bindtap="closeDatePicker">取消</button><button class="date-confirm" bindtap="confirmDatePicker">确定</button></view>
  </view>
</view>
