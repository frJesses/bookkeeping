<adaptive-viewport include-status-bar="{{true}}" include-bottom-safe-area="{{true}}" background="linear-gradient(145deg, #80e8d0 0%, #c7f8e9 64%, #f8f8f8 100%)">
<view class="landing-page">
  <view class="landing-main">
    <view class="ds-header"><view class="ds-back" bindtap="goBack"></view><text class="ds-header-title">添加记账</text></view>
    <view class="landing-month">
      <view><text>{{monthLabel}} ▾</text><text>太棒了，你已经连续记账{{recordedDays}}天啦~</text></view>
      <view class="month-nav {{!canGoPreviousMonth ? 'month-nav-disabled' : ''}}" bindtap="handlePreviousMonth">‹</view>
      <view class="month-nav {{!canGoNextMonth ? 'month-nav-disabled' : ''}}" bindtap="handleNextMonth">›</view>
    </view>
    <view class="landing-week"><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view>
    <view class="landing-grid">
      <view wx:for="{{days}}" wx:key="key" class="landing-day {{item.isMuted ? 'landing-muted' : ''}} {{item.isDisabled ? 'landing-disabled' : ''}} {{item.isActive ? 'landing-active' : ''}}" data-date="{{item.date}}" data-disabled="{{item.isDisabled}}" bindtap="selectDay">
        <view wx:if="{{item.hasRecord && !item.isActive}}" class="day-dot"></view><text class="{{item.isToday ? 'landing-today-label' : ''}}">{{item.isToday ? '今日' : item.label}}</text>
      </view>
    </view>
  </view>
  <view class="landing-ledger">
    <view class="landing-ledger-head"><text>{{selectedDateLabel}}</text><text>支出: {{selectedExpenseText}}</text></view>
    <view class="landing-divider"></view>
    <scroll-view scroll-y class="landing-records" show-scrollbar="false">
      <view wx:if="{{errorMessage}}" class="landing-state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重新加载</button></view>
      <view wx:elif="{{isLoading}}" class="landing-state">正在加载</view>
      <view wx:elif="{{!selectedRecords.length}}" class="landing-state">当天暂无账单</view>
      <view wx:else><view wx:for="{{selectedRecords}}" wx:key="recordKey" class="landing-record"><image src="{{item.iconUrl}}" mode="aspectFit"></image><view><text>{{item.title}}</text><text>{{item.tagText}}</text></view><text>{{item.amountSign}}{{item.amountValue}}</text></view></view>
    </scroll-view>
    <button bindtap="startEntry"><image src="/assets/figma/calendar/add-record.png" mode="aspectFit"></image><text>记一笔</text></button>
  </view>
</view>
</adaptive-viewport>
