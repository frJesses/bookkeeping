<view class="page">
  <view class="page-backdrop"></view>
  <view class="custom-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-main" style="height: {{navBarHeight}}px;">
      <view class="header-back" bindtap="goBack">
        <text class="header-back-icon">‹</text>
      </view>
      <view class="header-switch">
        <add-type-switch activeType="{{activeType}}" bind:change="handleTypeChange" />
      </view>
      <view
        class="header-capsule-placeholder"
        style="margin-top: {{capsuleTop - statusBarHeight}}px; height: {{capsuleHeight}}px; width: {{capsuleWidth}}px; margin-right: {{capsuleRight}}px;"
      ></view>
    </view>
  </view>
  <scroll-view scroll-y show-scrollbar="false" class="page-scroll">
    <view class="page-content {{activeCategory ? 'page-content-with-composer' : ''}}" style="padding-top: calc({{statusBarHeight + navBarHeight}}px + 44rpx);">
      <view wx:if="{{categoryLoading}}" class="category-state">正在加载分类</view>
      <view wx:elif="{{categoryError}}" class="category-state category-state-error">
        <text>{{categoryError}}</text>
        <button class="category-retry" bindtap="handleCategoryRetry">重新加载</button>
      </view>
      <add-category-grid
        wx:else
        categories="{{categories}}"
        activeCategory="{{activeCategory}}"
        bind:select="handleCategorySelect"
      />
    </view>
  </scroll-view>
  <add-entry-composer
    wx:if="{{activeCategory}}"
    categoryName="{{activeCategory}}"
    categoryIcon="{{activeCategoryIcon}}"
    amount="{{amountDisplay}}"
    remark="{{remark}}"
    dateValue="{{selectedDate}}"
    dateLabel="{{dateLabel}}"
    isRelativeDateLabel="{{isRelativeDateLabel}}"
    maxDate="{{maxDate}}"
    submitLabel="{{submitLabel}}"
    keyboardRows="{{keyboardRows}}"
    bind:keytap="handleKeyTap"
    bind:remarkchange="handleRemarkChange"
    bind:datechange="handleDateChange"
    bind:done="saveRecord"
  />
</view>
