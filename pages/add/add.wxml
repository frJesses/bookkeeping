<view class="page">
  <scroll-view scroll-y show-scrollbar="false" class="page-scroll">
    <view class="page-content">
      <view class="type-row">
        <view class="type-tabs">
          <view
            class="type-tab {{activeType === 'expense' ? 'type-tab-active' : ''}}"
            data-type="expense"
            bindtap="selectType"
          >
            支出
          </view>
          <view
            class="type-tab {{activeType === 'income' ? 'type-tab-active' : ''}}"
            data-type="income"
            bindtap="selectType"
          >
            收入
          </view>
          <view
            class="type-tab {{activeType === 'other' ? 'type-tab-active' : ''}}"
            data-type="other"
            bindtap="selectType"
          >
            其他
          </view>
        </view>

        <view class="time-pill">
          <text class="time-pill-icon">◔</text>
          <text class="time-pill-text">今天 11:26</text>
        </view>
      </view>

      <view class="amount-panel">
        <text class="amount-unit">¥</text>
        <van-field
          value="{{amount}}"
          border="{{false}}"
          custom-class="amount-field"
          data-field="amount"
        >
          <input
            slot="input"
            class="amount-native-input"
            type="digit"
            value="{{amount}}"
            placeholder="0.00"
            placeholder-class="amount-native-placeholder"
            cursor-spacing="12"
            data-field="amount"
            bindinput="onFieldInput"
          />
        </van-field>
      </view>

      <view class="divider"></view>

      <scroll-view scroll-y show-scrollbar="false" class="category-scroll">
        <view class="category-grid">
          <block wx:for="{{categories}}" wx:key="name">
            <view
              class="category-item"
              data-name="{{item.name}}"
              bindtap="selectCategory"
            >
              <view class="category-icon-wrap {{activeCategory === item.name ? 'category-icon-wrap-active' : ''}} {{item.tone === 'add' ? 'category-icon-wrap-add' : ''}}">
                <view class="category-icon {{activeCategory === item.name ? 'category-icon-active' : ''}} {{item.tone === 'add' ? 'category-icon-add' : ''}}">
                  {{item.icon}}
                </view>
              </view>
              <text class="category-name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </scroll-view>

      <van-cell-group custom-class="remark-group">
        <van-field
          label="备注"
          value="{{remark}}"
          border="{{false}}"
          clearable
          placeholder="点击添加备注"
          custom-class="remark-field"
          label-class="remark-field-label"
          input-class="remark-field-input"
          data-field="remark"
          bind:input="onFieldInput"
        />
      </van-cell-group>

      <view class="save-bar">
        <view class="save-button" bindtap="saveRecord">保存</view>
      </view>
    </view>
  </scroll-view>
</view>
