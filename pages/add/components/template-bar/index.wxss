.template-section {
  margin: 0 24rpx 30rpx 0;
  padding: 20rpx 20rpx 18rpx;
  border-radius: 24rpx;
  background: #f0fbf7;
}

.template-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.template-title {
  color: #1f2d3d;
  font-size: 26rpx;
  font-weight: 600;
}

.template-hint {
  color: #98a1b2;
  font-size: 21rpx;
}

.template-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.template-row {
  display: flex;
  gap: 16rpx;
}

.template-chip {
  display: flex;
  flex-shrink: 0;
  max-width: 420rpx;
  padding: 16rpx 20rpx;
  align-items: center;
  border: 1rpx solid #e3f6ef;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.template-chip-current {
  border-color: #01c6a6;
  background: #ffffff;
}

.template-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.template-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.template-name {
  color: #333333;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.template-meta {
  max-width: 220rpx;
  overflow: hidden;
  color: #98a1b2;
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-type {
  margin-left: 14rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.template-type.expense {
  background: #fff0ef;
  color: #ff6b6b;
}

.template-type.income {
  background: #e4f8f2;
  color: #01a98d;
}
