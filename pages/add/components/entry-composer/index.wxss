.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 0 calc(env(safe-area-inset-bottom) + 8rpx);
  background: rgba(255, 255, 255, 0.94);
  border-top-left-radius: 38rpx;
  border-top-right-radius: 38rpx;
  box-shadow: 0 -20rpx 50rpx rgba(26, 32, 53, 0.12);
  backdrop-filter: blur(22rpx);
}
.composer-handle {
  width: 110rpx;
  height: 10rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: #d9dfe9;
}
.composer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}
.composer-category {
  display: flex;
  align-items: center;
}
.composer-category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(220, 226, 238, 0.9);
}
.composer-category-icon-image {
  width: 38rpx;
  height: 38rpx;
}
.composer-category-icon-placeholder {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(120, 133, 164, 0.18);
}
.composer-category-copy {
  margin-left: 18rpx;
}
.composer-category-caption,
.composer-category-name,
.composer-amount,
.composer-remark-label,
.composer-remark-input,
.keypad-key-label,
.keypad-date-text {
  display: block;
}
.composer-category-caption {
  font-size: 20rpx;
  color: #99a1b4;
}
.composer-category-name {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #1c2239;
  font-weight: 700;
}
.composer-amount {
  max-width: 360rpx;
  font-size: 70rpx;
  line-height: 1;
  color: #1b1f2e;
  font-weight: 300;
  text-align: right;
  word-break: break-all;
}
.composer-remark {
  display: flex;
  align-items: center;
  margin: 18rpx 32rpx 20rpx;
  padding: 0 24rpx;
  height: 90rpx;
  border-radius: 24rpx;
  background: #f5f7fb;
}
.composer-remark-label {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: #22283f;
  font-weight: 600;
}
.composer-remark-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2c334d;
}
.composer-remark-placeholder {
  color: #c0c6d4;
}
.keypad {
  border-top: 1rpx solid rgba(220, 226, 238, 0.9);
  border-left: 1rpx solid rgba(220, 226, 238, 0.9);
}
.keypad-row {
  display: flex;
}
.keypad-key {
  width: 25%;
  height: 132rpx;
  border-right: 1rpx solid rgba(220, 226, 238, 0.9);
  border-bottom: 1rpx solid rgba(220, 226, 238, 0.9);
  box-sizing: border-box;
  background: #ffffff;
}
.keypad-key-primary {
  background: linear-gradient(180deg, #ffe275 0%, #ffd84d 100%);
}
.keypad-key-label {
  height: 100%;
  text-align: center;
  line-height: 132rpx;
  font-size: 38rpx;
  color: #161c2f;
  font-weight: 400;
}
.keypad-key-label-primary {
  font-size: 34rpx;
  font-weight: 700;
}
.keypad-key-label-backspace {
  font-size: 44rpx;
}
.keypad-picker {
  display: block;
}
.keypad-date {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 132rpx;
}
.keypad-date-absolute {
  padding: 0 8rpx;
  box-sizing: border-box;
}
.keypad-date-icon {
  position: relative;
  width: 42rpx;
  height: 40rpx;
  border: 3rpx solid #2d3245;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.keypad-date-ring {
  position: absolute;
  top: -8rpx;
  width: 4rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #2d3245;
}
.keypad-date-ring-left {
  left: 10rpx;
}
.keypad-date-ring-right {
  right: 10rpx;
}
.keypad-date-line {
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  top: 13rpx;
  height: 3rpx;
  background: #2d3245;
}
.keypad-date-dot {
  position: absolute;
  top: 22rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #2d3245;
}
.keypad-date-dot-left {
  left: 9rpx;
}
.keypad-date-dot-center {
  left: 18rpx;
}
.keypad-date-dot-right {
  right: 9rpx;
}
.keypad-date-text {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #171d2f;
  font-weight: 500;
}
.keypad-date-text-absolute {
  margin-left: 0;
  font-size: 22rpx;
  line-height: 1.2;
}
