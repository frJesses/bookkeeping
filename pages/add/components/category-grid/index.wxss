.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx 0;
}
.category-card {
  width: 25%;
  box-sizing: border-box;
  text-align: center;
}
.category-card-active {
  transform: translateY(-2rpx);
}
.category-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto;
  border-radius: 28rpx;
  transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
}
.category-card-icon-image {
  width: 44rpx;
  height: 44rpx;
}
.category-card-icon-placeholder {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(120, 133, 164, 0.16);
}
.category-card-name {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #3c445d;
  font-weight: 500;
}
.category-card-name-active {
  color: #171d2f;
  font-weight: 600;
}
